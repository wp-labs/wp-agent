// warp-insight 生成与部署目标

target<bin> warp-agentd {
  modules Control.AgentFacingInterface, Control.AgentEnrollment, Control.AgentRegistration, Control.AgentIdentity, Control.AgentCredential
  modules Control.AgentCommand, Control.Protocol, Control.AgentRegistry
  modules Discovery.Config, Discovery.Probe, Discovery.Collect, Discovery.Execute
  modules Observed.Snapshot, Observed.Entity
  modules Reporting.Protocol, Reporting.Contract, Reporting.Health, Reporting.Pipeline
}
