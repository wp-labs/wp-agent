// 系统分解：顶层子系统边界

subsystem WarpGateWay {
  meta {
    label zh "控制平台"
    summary zh "中心侧控制、治理、编译、下发、跟踪与风险控制。"
    tag "control-plane"
  }

  uses module Control.GateWayWebFrontend
  uses module Control.UserFacingInterface, Control.AgentFacingInterface
  uses module Control.AgentEnrollment, Control.AgentRegistration, Control.AgentIdentity, Control.AgentCredential, Control.AgentStatus
  uses module Control.AgentCommand
  uses module Control.Protocol, Control.AgentRegistry, Control.AgentStatus
  uses module Control.GateWayManagement, Control.GateWayManagement
  uses module Control.GateWayApplication
}
