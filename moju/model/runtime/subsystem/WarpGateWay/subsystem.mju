// 系统分解：顶层子系统边界

subsystem WarpGateWay {
  meta {
    label zh "控制平台"
    summary zh "中心侧控制、治理、编译、下发、跟踪与风险控制。"
    tag "control-plane"
  }

  uses module Control.GatewayApp.WebFrontend
  uses module Control.GatewayApp.UserFacingInterface, Control.AgentApp.FacingInterface
  uses module Control.Agent.Enrollment, Control.Agent.Registration, Control.Agent.Identity, Control.Agent.Credential, Control.Agent.Status
  uses module Control.Agent.Command
  uses module Control.Protocol, Control.Agent.Registry, Control.Agent.Status
  uses module Control.Gateway.Management, Control.Gateway.Management
  uses module Control.GatewayApp.Application
}
