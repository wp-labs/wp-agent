// WarpGateway 子系统用例

// 通过 URL 初始化
usecase InitializeGatewayViaUrl {
  meta {
    label zh "通过 URL 初始化"
    label en "Initialize Gateway via URL"
    summary zh "WarpGateway 实例安装后通过控制中心初始化 URL（control_center_endpoint）获取初始配置，完成网关初始化。"
    tags "gateway", "bootstrap", "initialize", "config"
  }

  actor Control.AdminOperator
  trigger Control.AdminGetGatewayInitialConfig
  outcome Control.GatewayInitialConfig
}

// 注册到 WarpInsightCenter
usecase RegisterToInsightCenter {
  meta {
    label zh "注册到 WarpInsightCenter"
    label en "Register to WarpInsightCenter"
    summary zh "WarpGateway 实例向 WarpInsightCenter 上报网关状态，完成在线注册并进入中心监管视图。"
    tags "gateway", "register", "status", "supervision"
  }

  actor Control.WarpGateway
  trigger Control.ReportGatewayStatus
  outcome Control.GatewayStatusAccepted
  flow Control.RegisterGatewayFlow
}

// 获取 Agent 安装代码
usecase GetAgentInstallCode {
  meta {
    label zh "获取 Agent 安装代码"
    label en "Get Agent Install Code"
    tags "agent-install", "install-code", "public"
  }

  actor Control.OperationsEngineer
  trigger Control.GetAgentInstallCode
  outcome Control.AgentInstallCode
}

// 获取 Agent 总览
usecase GetAgentOverview {
  meta {
    label zh "获取 Agent 总览"
    label en "Get Agent Overview"
    tags "agent-status", "overview", "admin", "home"
  }

  actor Control.AdminOperator
  trigger Control.GetAgentOverview
  outcome Control.AgentOverview
}

// 展示 Agent 的运行状态
usecase ShowAgentRuntimeStatus {
  meta {
    label zh "展示 Agent 的运行状态"
    label en "Show Agent Runtime Status"
    tags "agent-status", "admin"
  }

  actor Control.AdminOperator
  trigger Control.ShowAgentRuntimeStatus
  outcome Control.AgentRuntimeStatus
}

// 暂停 Agent
usecase PauseAgent {
  meta {
    label zh "暂停 Agent"
    label en "Pause Agent"
    tags "agent-pause", "admin"
  }

  actor Control.AdminOperator
  trigger Control.PauseAgent
  outcome Control.DispatchReceipt
}

// 远程升级 Agent
usecase UpgradeAgentRemotely {
  meta {
    label zh "远程升级 Agent"
    label en "Upgrade Agent Remotely"
    tags "agent-upgrade", "admin"
  }

  actor Control.AdminOperator
  trigger Control.UpgradeAgent
  outcome Control.DispatchReceipt
}
