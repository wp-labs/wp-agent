// WarpGateWay control center page layout regions

region AdminOperatorLane {
  meta {
    label zh "管理操作者区域"
    label en "Admin Operator Area"
    summary zh "控制中心中展示 AdminOperator 身份和访问方式，表达控制操作由管理员发起。"
    tags "admin", "actor", "agent-control"
  }

  orientation horizontal
  contains AdminOperatorIdentity { slot_actor: AdminOperator }
  contains AdminOperatorAccess { slot_protocol: "http" }
}

region AgentControlUsecaseBoard {
  meta {
    label zh "Agent 控制用例板"
    label en "Agent Control Usecase Board"
    tags "admin", "agent-control", "usecase-layout"
  }

  orientation grid
  contains PauseAgentUsecaseCard { slot_usecase: PauseAgent }
  contains UpgradeAgentRemotelyUsecaseCard { slot_usecase: UpgradeAgentRemotely }
  layout fill_remaining
}

region AdminOperatorIdentity {
  meta {
    label zh "操作者身份"
    label en "Admin Operator AgentIdentity"
    summary zh "表达 AdminOperator 是控制中心操作的发起者。"
    tags "admin", "actor"
  }

  orientation vertical
}

region AdminOperatorAccess {
  meta {
    label zh "操作者访问方式"
    label en "Admin Operator Access"
    tags "admin", "access"
  }

  orientation vertical
}
