// 系统分解：顶层子系统边界

// WarpInsightCenter — WarpGateWay 的上级聚合控制系统
// 汇总各 WarpGateWay 实例的状态、健康与总览，并下发全局策略与控制指令。
// 骨架阶段先组合 Control 域既有模块作为基础；网关舰队视图、全局指令派发、
// 网关注册等聚合域契约在后续迭代建模。

subsystem WarpInsightCenter {
  meta {
    label zh "全局控制中心"
    label en "Warp Control Center"
    summary zh "WarpGateWay 的上级聚合控制系统，汇总各 WarpGateWay 实例的状态、健康与总览，并下发全局策略与控制指令。"
    tag "control-plane"
    tag "aggregation"
    tag "global"
  }

  uses module Control.Registry, Control.Protocol
  uses module Control.AgentdStatusManagement, Control.AgentCommandControl
  uses module Control.GatewaySupervision
}
