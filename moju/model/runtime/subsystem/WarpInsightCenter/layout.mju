// WarpInsightCenter WEB Layout index
//
// 全局控制中心轻量布局：顶部导航 + 资产/安全治理四个页面。
// 页面内部与可复用区域可后续按页拆到 ./layout/*.mju。

region GlobalTopNavigation {
  meta {
    label zh "顶部导航"
    label en "Top Navigation"
    summary zh "WarpInsightCenter 的顶部导航区，作为四个独立页面共享的页面级导航，提供资产、网络拓扑、服务拓扑和漏洞入口。"
    tag "center"
    tag "navigation"
    tag "top-navigation"
    tag "layout-index"
  }

  orientation horizontal
}

region<page> AssetOverviewPage {
  meta {
    label zh "资产总览"
    label en "Asset Overview"
    summary zh "WarpInsightCenter 的资产总览页，展示主机资产目录、运行状态与有效责任。"
    tag "center"
    tag "asset"
    tag "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains HostHostInventoryQuery { slot_usecase: QueryHostInventory }
  contains HostRuntimeStateView { slot_usecase: ViewHostRuntimeState }
  contains EffectiveResponsibilityView { slot_usecase: ViewEffectiveHostResponsibility }
  layout fill_remaining
}

region<section> HostHostInventoryQuery {
  meta {
    label zh "主机资产查询"
    label en "Host HostInventory Query"
    summary zh "按租户、环境或主机名查询主机资产目录的查询区域。"
    tag "center"
    tag "asset"
    tag "query"
  }

  orientation vertical
}

region<section> HostRuntimeStateView {
  meta {
    label zh "主机运行状态"
    label en "Host Runtime State View"
    summary zh "展示指定主机当前运行态快照的区域。"
    tag "center"
    tag "asset"
    tag "runtime-state"
  }

  orientation vertical
}

region<section> EffectiveResponsibilityView {
  meta {
    label zh "有效责任"
    label en "Effective HostResponsibility View"
    summary zh "展示主机有效责任主体（owner/maintainer/oncall/security_owner）及其来源的区域。"
    tag "center"
    tag "responsibility"
  }

  orientation vertical
}

region<page> NetworkTopologyPage {
  meta {
    label zh "网络拓扑"
    label en "Network Topology"
    summary zh "WarpInsightCenter 的网络拓扑页，展示 host / pod / network 的挂接关系。"
    tag "center"
    tag "topology"
    tag "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains NetworkTopologyView { slot_usecase: ViewNetworkTopology }
  layout fill_remaining
}

region<section> NetworkTopologyView {
  meta {
    label zh "网络拓扑视图"
    label en "Network Topology View"
    summary zh "展示主机、pod 与网络段挂接关系的拓扑区域。"
    tag "center"
    tag "topology"
    tag "network"
  }

  orientation grid
}

region<page> ServiceTopologyPage {
  meta {
    label zh "服务拓扑"
    label en "Service Topology"
    summary zh "WarpInsightCenter 的服务拓扑页，展示业务、系统、服务及其依赖与实例分布。"
    tag "center"
    tag "topology"
    tag "service"
    tag "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains ServiceTopologyView { slot_usecase: ViewServiceTopology }
  layout fill_remaining
}

region<section> ServiceTopologyView {
  meta {
    label zh "服务拓扑视图"
    label en "Service Topology View"
    summary zh "展示业务、系统、服务及其依赖、入口与实例分布的拓扑区域。"
    tag "center"
    tag "topology"
    tag "service"
  }

  orientation grid
}

region<page> VulnerabilityPage {
  meta {
    label zh "漏洞"
    label en "SoftwareVulnerability"
    summary zh "WarpInsightCenter 的漏洞页，展示软件漏洞发现与整改跟进。"
    tag "center"
    tag "vulnerability"
    tag "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains SoftwareVulnerabilityView { slot_usecase: ViewSoftwareVulnerabilities }
  layout fill_remaining
}

region<section> SoftwareVulnerabilityView {
  meta {
    label zh "软件漏洞视图"
    label en "Software SoftwareVulnerability View"
    summary zh "展示软件漏洞发现列表与整改跟进状态的区域。"
    tag "center"
    tag "vulnerability"
  }

  orientation vertical
}
