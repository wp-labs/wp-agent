// Control domain HTTP bindings

bind WarpGatewayPublicInstallInterface {
  entry AdminGetAgentInstallCode {
    route GET "/api/v1/agent/install-code"
    auth bearer
    actor_identity OperationsEngineer.id from token.sub
    status AgentInstallCode 200
  }

  entry GatewayContainerInstallRequested {
    route POST "/api/v1/gateway/container-install"
    auth bearer
    actor_identity CustomerServiceEngineer.id from token.sub
    status GatewayInstallReceipt 202
  }

  entry GatewayImageDownloadRequested {
    route POST "/api/v1/gateway/image-download"
    auth bearer
    actor_identity CustomerServiceEngineer.id from token.sub
    status GatewayImageDownloadReceipt 202
  }
}

bind WarpGatewayManagementInterface {
  entry AdminShowAgentRuntimeStatus {
    route GET "/api/v1/admin/agents/{agent_id}/runtime-status"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentRuntimeStatus 200
  }

  entry AdminGetAgentOverview {
    route GET "/api/v1/admin/agents/overview"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentOverview 200
  }

  entry AdminPauseAgent {
    route POST "/api/v1/admin/agents/{agent_id}/pause"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status DispatchReceipt 202
  }

  entry AdminUpgradeAgent {
    route POST "/api/v1/admin/agents/{agent_id}/upgrade"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status DispatchReceipt 202
  }

  entry AdminViewGatewayManagementState {
    route GET "/api/v1/admin/gateway/management-state"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status GatewayManagementState 200
  }

  entry AdminLookupAgentRegistryEntry {
    route GET "/api/v1/admin/agents/{agent_id}/registry-entry"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentRegistryEntry 200
  }

  entry AdminQueryAgentCapabilityIndex {
    route GET "/api/v1/admin/agents/{agent_id}/capability-index"
    auth bearer
    actor_identity AdminOperator.id from jwt.sub
    status AgentCapabilityIndex 200
  }
}

bind WpAgentOnlineRegistrationInterface {
  entry SubmitEnrollmentRequest {
    route POST "/api/v1/agent/enroll"
    auth none
    status AgentEnrollmentResult 201
  }

  entry SubmitAgentStatus {
    route POST "/api/v1/agent/status"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status Reporting.AgentStatusAccepted 202
    outcome Reporting.AgentStatusAccepted on Reporting.AgentStatusAccepted
  }

  entry RenewAgentCredential {
    route POST "/api/v1/agent/credentials:renew"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status AgentCredentialBundle 200
  }

  entry PollControlCommands {
    route POST "/api/v1/agent/control-commands:poll"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status AgentControlCommandsReturned 200
    outcome AgentControlCommandsReturned on ControlCommandsReturned
  }

  entry ReportActionResult {
    route POST "/api/v1/agent/action-results"
    auth bearer
    actor_identity Agentd.id from credential.agent_id
    status Reporting.ActionResultAccepted 202
    outcome Reporting.ActionResultAccepted on Reporting.ActionResultReceipt
  }
}

bind WarpInsightCenterGatewayInterface {
  entry RegisterGateway {
    route POST "/api/v1/gateway/register"
    auth none
    status GatewayEnrollmentResult 200
  }

  entry GetGatewayInitialConfig {
    route GET "/api/v1/gateway/initial-config"
    auth bearer
    actor_identity WarpGateway.id from credential.gateway_id
    status GatewayInitialConfig 200
  }

  entry ReportGatewayStatus {
    route POST "/api/v1/gateway/status"
    auth bearer
    actor_identity WarpGateway.id from credential.gateway_id
    status GatewayStatusAccepted 200
  }

  entry RenewGatewayCredential {
    route POST "/api/v1/gateway/credentials:renew"
    auth bearer
    actor_identity WarpGateway.id from credential.gateway_id
    status GatewayCredentialBundle 200
  }
}

bind WarpInsightCenterAdminInterface {
  entry AdminViewGatewayList {
    route GET "/api/v1/admin/gateways"
    auth bearer
    actor_identity GatewayOperator.id from jwt.sub
    status Projection<List<GatewayInstance>> 200
  }

  entry AdminDispatchGlobalPolicy {
    route POST "/api/v1/admin/policies/global"
    auth bearer
    actor_identity PlatformMaintenanceEngineer.id from jwt.sub
    status GlobalPolicyDispatch 200
  }

  entry AdminShowGatewayStatus {
    route GET "/api/v1/admin/gateways/{gateway_id}/status"
    auth bearer
    actor_identity CustomerServiceEngineer.id from jwt.sub
    status GatewayRuntimeStatus 200
  }

  entry AdminListGatewayStatus {
    route GET "/api/v1/admin/gateways/status"
    auth bearer
    actor_identity CustomerServiceEngineer.id from jwt.sub
    status List<GatewayRuntimeStatus> 200
  }

  entry AdminCreateGatewayInstance {
    route POST "/api/v1/admin/gateways"
    auth bearer
    actor_identity BusinessAdministrator.id from jwt.sub
    status GatewayInstance 201
  }

  entry AdminBindGatewayCustomer {
    route POST "/api/v1/admin/gateways/{gateway_id}/customer"
    auth bearer
    actor_identity BusinessAdministrator.id from jwt.sub
    status GatewayCustomerBinding 200
  }

  entry RevealBootstrapToken {
    route GET "/api/v1/admin/gateways/{gateway_id}/bootstrap-token"
    auth bearer
    actor_identity BusinessAdministrator.id from jwt.sub
    status GatewayBootstrapToken 200
  }

  entry RotateBootstrapToken {
    route POST "/api/v1/admin/gateways/{gateway_id}/bootstrap-tokens/rotate"
    auth bearer
    actor_identity BusinessAdministrator.id from jwt.sub
    status GatewayBootstrapToken 200
  }
}
