module<service> WarpInsightCenter {
  meta {
    label zh "全局控制中心应用编排"
    label en "WarpInsightCenter Application Orchestration"
    summary zh "负责 WarpInsightCenter 的 Application 层编排：网关舰队聚合、全局策略下发等用例级命令与流程。"
    tag "control"
    tag "center"
    tag "application"
  }

  layer Application
  owns ViewGatewayFleet
  owns ViewGatewayFleetFlow
  owns DispatchGlobalPolicy
  owns DispatchGlobalPolicyFlow
  depends GatewaySupervision, PlatformRelease
  depends Observed.HostInventory, Observed.HostResponsibility
  depends Observed.NetworkTopology, Observed.ServiceTopology
  depends Security.SoftwareVulnerability
  responsible_for "全局控制中心应用编排：网关舰队聚合视图、全局策略下发与回执，组合中心各 Domain 模块完成编排。"
}
