module<service> GatewaySupervision {
  meta {
    label zh "网关注册与状态"
    label en "Gateway Supervision"
    summary zh "负责 WarpGateWay 实例在 WarpInsightCenter 的初始配置获取、状态上报与全局状态视图。"
    tag "control"
    tag "gateway"
    tag "supervision"
  }

  layer Domain
  owns GetGatewayInitialConfig
  owns GatewayInitialConfig
  owns ReportGatewayStatus
  owns GatewayStatusAccepted
  owns ShowGatewayStatus
  owns GatewayStatusView
  responsible_for "WarpGateWay 上级聚合：初始配置获取、状态上报接收、全局状态视图。"
}
