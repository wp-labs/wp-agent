module<logic> GatewaySupervision {
  meta {
    label zh "网关注册与状态"
    label en "Gateway Supervision"
    summary zh "负责 WarpGateWay 实例在 WarpInsightCenter 的监管逻辑：初始配置获取、状态上报、状态、实例、客户绑定、舰队视图与策略下发回执；实例管理命令由 GatewayInstanceManagement 承载。"
    tag "control"
    tag "gateway"
    tag "supervision"
  }

  layer Domain
  owns GatewayInitialConfig
  owns GatewayStatusAccepted
  owns GatewayStatusView
  owns GatewayInstance
  owns GatewayCustomerBinding
  owns GatewayFleetView
  owns GlobalPolicyDispatch
  owns GetGatewayInitialConfig
  owns ReportGatewayStatus
  responsible_for "WarpGateWay 上级聚合：初始配置获取、状态上报、状态回执、状态视图、管理实例、客户绑定、舰队视图与策略下发回执；网关身份由 GateWayIdentity 表达，实例管理命令由 GatewayInstanceManagement 承载。"
}
