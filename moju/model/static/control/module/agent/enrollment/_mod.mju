module<entity> Agent.Enrollment {
  meta {
    label zh "注册与引导实体"
    label en "AgentEnrollment"
    summary zh "负责 Agent 注册领域实体：安装引导包、注册 token 与校验、注册结果、认证配置与安装代码；注册流程由 AgentRegistration 承载。"
    tags "control", "enrollment"
  }

  layer Domain
  depends Control.Agent.Identity
  depends Control.Agent.Registry
  responsible_for "注册与引导：bootstrap 信息、注册 token、校验/结果、注册事件、认证配置与安装代码；注册流程由 AgentRegistration 承载。"
}
