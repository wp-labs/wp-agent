// Module: AgentStatus — Agentd 状态管理

struct AgentInstance {
  meta {
    label zh "Agentd 实例"
    label en "Agentd Instance"
    summary zh "一次 Agentd 运行实例的状态记录，包含 boot id、版本、启动时间和最后在线时间。"
    tags "agentd", "status"
  }

  unique instance_id: String
  agent_id: String
  boot_id: String
  version: String
  started_at: DateTime
  last_seen_at: DateTime
}

command ShowAgentRuntimeStatus {
  agent_id: String
  requested_by: String
}

command GetAgentOverview {
  requested_by: String
}

struct AgentRuntimeStatusView {
  meta {
    label zh "Agentd 运行状态视图"
    label en "Agentd Runtime Status View"
    summary zh "WarpGateWay 展示 Agentd 在线状态、版本、健康状态和最后上报时间所需的聚合视图。"
    tags "agentd", "status-view"
  }

  agent_id: String
  instance_id: String
  version: String
  status: String
  last_seen_at: DateTime
  health: String
  memory_bytes: Int?
  cpu_percent: Float?
  admin_latency_ms: Int?
}

struct AgentOverviewMetrics {
  meta {
    label zh "Agent 总览指标"
    label en "Agent Overview Metrics"
    tags "agentd", "status", "overview", "metrics"
  }

  total_agents: Int
  online_agents: Int
  unhealthy_agents: Int
  last_seen_lag_seconds: Int
}

struct RecentOnlineRegisteredAgent {
  meta {
    label zh "最近上线注册 Agent"
    label en "Recent Online Registered Agent"
    tags "agentd", "status", "overview", "recent-online"
  }

  agent_id: String
  instance_id: String
  version: String
  registered_at: DateTime
  online_since: DateTime
  online_duration_seconds: Int
}

struct AgentOverview {
  meta {
    label zh "Agent 总览"
    label en "Agent Overview"
    tags "agentd", "status", "overview", "admin-home"
  }

  metrics: AgentOverviewMetrics
  recent_online_agents: List<RecentOnlineRegisteredAgent>
  abnormal_agents: List<AgentRuntimeStatusView>
}

// ── Agent 登记查询（AgentRegistryQuery 并入） ──

command LookupAgentRegistryEntry {
  meta {
    label zh "查询 Agent 登记记录"
    label en "Lookup Agent Registry Entry"
    tags "agentd", "registry", "lookup"
  }

  agent_id: String
  requested_by: String
}

command QueryAgentCapabilityIndex {
  meta {
    label zh "查询 Agent 能力索引"
    label en "Query Agent Capability Index"
    tags "agentd", "registry", "capability"
  }

  agent_id: String
  requested_by: String
}
