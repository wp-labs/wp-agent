// Module: AgentCommand — Agent 控制指令编排

command PauseAgent {
  meta {
    label zh "暂停 Agent"
    label en "Pause Agent"
    tags "agentd", "control-command", "pause"
  }

  agent_id: String
  requested_by: String
  requested_at: DateTime
}

command UpgradeAgent {
  meta {
    label zh "远程升级 Agent"
    label en "Upgrade Agent"
    tags "agentd", "control-command", "upgrade"
  }

  agent_id: String
  target_version: String
  requested_by: String
  requested_at: DateTime
}

command RefreshPolicyHint {
  meta {
    label zh "刷新策略提示"
    label en "Refresh Policy Hint"
    tags "agentd", "control-command", "policy"
  }

  policy_version: String
  reason_code: String
}

command RotateIdentityHint {
  meta {
    label zh "轮换身份提示"
    label en "Rotate AgentIdentity Hint"
    summary zh "管理节点下发给 Agentd 的身份轮换提示，指示 Agentd 在指定时间前更新凭据。"
    tags "agentd", "control-command", "identity"
  }

  reason_code: String
  renew_before: DateTime
}

struct AgentControlCommand {
  meta {
    label zh "Agent 控制指令"
    label en "Agent Control Command"
    tags "agentd", "control-command"
  }

  unique command_id: String
  agent_id: String
  command_kind: String
  target_version: String
  payload: String
  requested_by: String
  issued_at: DateTime
  expires_at: DateTime
  sequence: Int
}

struct DispatchReceipt {
  meta {
    label zh "控制指令派发回执"
    label en "Dispatch Receipt"
    tags "agentd", "dispatch", "control-command"
  }

  agent_id: String
  command_id: String
  dispatch_id: String
  status: String
  created_at: DateTime
}

struct AgentFleetDispatchReceipt {
  meta {
    label zh "Agent 列表派发回执"
    label en "Agent Fleet Dispatch Receipt"
    tags "gateway", "agent-command"
  }

  unique dispatch_id: String
  command_kind: String
  target_count: Int
  status: String
  created_at: DateTime
}

event ControlCommandsReturned {
  meta {
    label zh "控制指令已返回"
    label en "Control Commands Returned"
    tags "agentd", "control-command", "polling"
  }

  agent_id: String
  instance_id: String
  messages: List<AgentControlCommand>
  next_sequence: Int
  returned_at: DateTime
}

event ControlLongPollTimedOut {
  meta {
    label zh "控制指令长轮询超时"
    label en "Control Long Poll Timed Out"
    tags "agentd", "control-command", "polling"
  }

  agent_id: String
  instance_id: String
  wait_ms: Int
  timed_out_at: DateTime
}
