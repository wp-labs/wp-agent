module<ui> AdminWebFrontend {
  meta {
    label zh "WarpGateWay 前端 WEB"
    label en "WarpGateWay Web Frontend"
    summary zh "WarpGateWay 的浏览器端 WEB 前端，承载主界面、Agent 控制界面，并通过后端 WEB 服务接口完成管理操作。"
    tag "admin"
    tag "web"
    tag "frontend"
  }

  layer Application
  depends UserFacingInterface
  responsible_for "WarpGateWay 前端 WEB：主界面、Agent 控制界面、状态展示、安装代码复制操作和远程升级操作入口。"
}
