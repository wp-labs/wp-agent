module<service> InsightCenterApp.WarpInsightCenter {
  meta {
    label zh "全局控制中心应用编排"
    label en "WarpInsightCenter Application Orchestration"
    summary zh "负责 WarpInsightCenter 的 Application 层编排：网关列表聚合、全局策略下发等用例级命令与流程。"
    tag "control"
    tag "center"
    tag "application"
  }

  layer Application
  owns ViewGatewayList
  owns ViewGatewayListFlow
  owns DispatchGlobalPolicy
  owns DispatchGlobalPolicyFlow
  depends Control.Gateway.Supervision, Control.InsightCenter.PlatformRelease
  depends Observed.HostInventory, Observed.HostResponsibility
  depends Observed.NetworkTopology, Observed.ServiceTopology
  depends Security.SoftwareVulnerability
  responsible_for "全局控制中心应用编排：网关列表聚合视图、全局策略下发与回执，组合中心各 Domain 模块完成编排。"
}

// Module: WarpInsightCenter — 全局控制中心应用编排
//
// WarpInsightCenter 的 Application 层编排：网关列表聚合、全局策略下发等
// 用例级命令与流程，组合各 Domain 模块的事实完成编排。

command ViewGatewayList {
  meta {
    label zh "查看网关列表"
    label en "View Gateway List"
    summary zh "全局操作者查看接入 WarpInsightCenter 的 WarpGateWay 实例列表聚合视图。"
    tag "center"
    tag "gateway"
    tag "list"
  }

  requested_by: String
}

command DispatchGlobalPolicy {
  meta {
    label zh "下发全局策略"
    label en "Dispatch Global Policy"
    summary zh "平台维护工程师在 WarpInsightCenter 向指定 WarpGateWay 实例列表下发全局策略版本。"
    tag "center"
    tag "policy"
  }

  policy_version: String
  gateway_ids: List<String>
  requested_by: String
}

flow ViewGatewayListFlow {
  meta {
    label zh "查看网关列表"
    label en "View Gateway List Flow"
    summary zh "聚合各 WarpGateWay 实例的在线、降级与离线状态，生成列表总览视图。"
    tag "center"
    tag "gateway"
    tag "list"
  }

  actor GatewayOperator
  trigger ViewGatewayList

  creates GatewayListView

  step BuildListView {
    create GatewayListView {
      gateway_count = 3
      online_count = 2
      degraded_count = 1
      offline_count = 0
      updated_at = "now"
    }
  }
}

flow DispatchGlobalPolicyFlow {
  meta {
    label zh "下发全局策略"
    label en "Dispatch Global Policy Flow"
    summary zh "向目标 WarpGateWay 列表下发指定策略版本，并生成派发回执。"
    tag "center"
    tag "policy"
  }

  actor PlatformMaintenanceEngineer
  trigger DispatchGlobalPolicy

  creates GlobalPolicyDispatch

  step DispatchPolicy {
    create GlobalPolicyDispatch {
      dispatch_id = DispatchGlobalPolicy.requested_by
      policy_version = DispatchGlobalPolicy.policy_version
      target_count = DispatchGlobalPolicy.gateway_ids
      status = "accepted"
      dispatched_at = "now"
    }
  }
}
