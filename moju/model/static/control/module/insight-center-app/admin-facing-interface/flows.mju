// Flows: AdminFacingInterface — 全局控制中心管理接口编排流程
//
// WarpInsightCenter 管理接口（forAdmin）的全部编排流程定义。
// 与 admin-facing-interface.mju 拆分：接口契约（命令/响应/接口条目）保留在
// admin-facing-interface.mju，本文件承载该接口的全部流程。流程仍归属
// module<interface> InsightCenterApp.AdminFacingInterface。

// ── 编排流程 ──

flow AdminViewGatewayListFlow {
  actor GatewayOperator
  trigger AdminViewGatewayList

  
}

flow AdminDispatchGlobalPolicyFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminDispatchGlobalPolicy

  
}

flow AdminShowGatewayStatusFlow {
  actor CustomerServiceEngineer
  trigger AdminShowGatewayStatus

  
}

flow AdminListGatewayStatusFlow {
  actor CustomerServiceEngineer
  trigger AdminListGatewayStatus

  
}

flow AdminCreateGatewayInstanceFlow {
  meta {
    label zh "创建 Gateway 管理实例并准备配置"
    label en "Create Gateway Instance and Prepare Config"
    summary zh "创建 Gateway 管理实例并签发注册 Token（含控制中心信任根），为网关生成初始配置文件。"
    tags "gateway", "provisioning", "config"
  }

  actor CustomerServiceEngineer
  trigger AdminCreateGatewayInstance

  creates GatewayInstance
  creates GatewayEnrollmentToken

  step CreateInstance {
    create GatewayInstance {
      gateway_id = AdminCreateGatewayInstance.gateway_name
      lifecycle_state = "Provisioned"
      created_at = "now"
    }
  }

  step IssueEnrollmentToken {
    create GatewayEnrollmentToken {
      token_id = "gw-enroll-001"
      token_hash = "sha256:token-hash"
      control_center_trust_bundle = "control-center.pem"
      max_uses = 1
      used_count = 0
      status = "Active"
      issued_at = "now"
      expires_at = "2026-09-01T00:00:00Z"
    }
  }
}

flow AdminBindGatewayCustomerFlow {
  actor CustomerServiceEngineer
  trigger AdminBindGatewayCustomer

  
}

flow AdminListGatewayInstancesFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminListGatewayInstances

  
}

flow AdminGetGatewayUptimeFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminGetGatewayUptime

  
}

flow AdminGetGatewayHistoryFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminGetGatewayHistory

  
}

flow AdminGetAgentHistoryFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminGetAgentHistory

  
}

flow AdminListGatewayAgentsFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminListGatewayAgents

  
}

flow AdminGetGatewayLifecycleFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminGetGatewayLifecycle

  
}

flow AdminGetGatewayInitialConfigFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminGetGatewayInitialConfig

  
}

flow AdminPublishReleaseFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminPublishRelease

  
}

flow AdminListReleasesFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminListReleases

  
}

flow AdminCreateUpgradePlanFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminCreateUpgradePlan

  
}

flow AdminListUpgradePlansFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminListUpgradePlans

  
}

flow AdminApproveUpgradePlanFlow {
  actor PlatformMaintenanceEngineer
  trigger AdminApproveUpgradePlan

  
}
