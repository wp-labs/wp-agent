module<interface> InsightCenterApp.AdminFacingInterface {
  meta {
    label zh "全局控制中心管理接口"
    label en "WarpInsightCenter Admin Facing Interface"
    summary zh "WarpInsightCenter 面向管理员暴露的 HTTP 管理接口，承载网关列表/策略编排与网关实例管理。"
    tag "center"
    tag "admin-facing"
    tag "management"
    tag "backend"
    tag "http"
    tag "interface"
  }

  layer Application
  owns WarpInsightCenterAdminInterface
  owns AdminViewGatewayList
  owns AdminGatewayListReturned
  owns AdminViewGatewayListFlow
  owns AdminDispatchGlobalPolicy
  owns AdminGlobalPolicyDispatchReturned
  owns AdminDispatchGlobalPolicyFlow
  owns AdminShowGatewayStatus
  owns AdminGatewayStatusReturned
  owns AdminShowGatewayStatusFlow
  owns AdminListGatewayStatus
  owns AdminGatewayStatusListReturned
  owns AdminListGatewayStatusFlow
  owns AdminCreateGatewayInstance
  owns AdminGatewayInstanceReturned
  owns AdminCreateGatewayInstanceFlow
  owns AdminBindGatewayCustomer
  owns AdminGatewayCustomerBindingReturned
  owns AdminBindGatewayCustomerFlow
  owns AdminQueryHostInventory
  owns AdminHostInventoryReturned
  owns AdminViewHostRuntimeState
  owns AdminHostRuntimeStateReturned
  owns AdminViewNetworkTopology
  owns AdminNetworkTopologyReturned
  owns AdminViewServiceTopology
  owns AdminServiceTopologyReturned
  owns AdminViewSoftwareVulnerabilities
  owns AdminSoftwareVulnerabilitiesReturned
  owns AdminViewEffectiveResponsibility
  owns AdminEffectiveResponsibilityReturned
  owns AdminListGatewayInstances
  owns AdminGatewayInstanceListReturned
  owns AdminGetGatewayUptime
  owns AdminGatewayUptimeReturned
  owns AdminGetGatewayHistory
  owns AdminGatewayHistoryReturned
  owns GatewayHistorySample
  owns AdminGetAgentHistory
  owns AdminAgentHistoryReturned
  owns AgentHistorySample
  owns AdminListGatewayAgents
  owns AdminGatewayAgentsReturned
  owns AdminGetGatewayLifecycle
  owns AdminGatewayLifecycleReturned
  owns GatewayLifecycleEvent
  owns AdminGetGatewayInitialConfig
  owns AdminPublishRelease
  owns AdminReleaseReturned
  owns AdminListReleases
  owns AdminReleasesReturned
  owns AdminCreateUpgradePlan
  owns AdminListUpgradePlans
  owns AdminApproveUpgradePlan
  owns AdminUpgradePlanReturned
  owns AdminUpgradePlansReturned
  provides WarpInsightCenterAdminInterface by protocol<http>
  depends Control.InsightCenterApp.WarpInsightCenter
  depends Control.Gateway.Supervision, Control.Gateway.InstanceManagement
  depends Control.InsightCenter.PlatformRelease
  depends Observed.HostInventory, Observed.HostResponsibility
  depends Observed.NetworkTopology, Observed.ServiceTopology
  depends Security.SoftwareVulnerability
  responsible_for "WarpInsightCenter 管理接口：作为管理员与自动化系统的 Application 层入口，承载网关列表/策略编排与网关实例管理。"
}

// Module: AdminFacingInterface — 全局控制中心管理接口（forAdmin）
//
// WarpInsightCenter 面向管理员的 HTTP 管理接口，与面向 WarpGateWay 实例的
// GateWayFacingInterface（forGateway）拆分。承载网关列表/策略编排与网关实例管理。
// 请求/响应为 wire 契约（Admin 前缀），组合中心各 Domain/Application 模块事实。

// ── 列表/策略编排 ──

message<command> AdminViewGatewayList = OperatorRequest {
}

message<response> AdminGatewayListReturned {
  list: GatewayListView
}

message<command> AdminDispatchGlobalPolicy = OperatorRequest {
  policy_version: String
  gateway_ids: List<String>
}

message<response> AdminGlobalPolicyDispatchReturned {
  dispatch: GlobalPolicyDispatch
}

// ── 网关实例管理 ──

message<command> AdminShowGatewayStatus = OperatorRequest {
  gateway_id: String
}

message<response> AdminGatewayStatusReturned {
  status: GatewayStatusView
}

// 状态卡片列表（喂前端网关列表页卡片栅格，代码实现对应 GET /api/v1/admin/gateways/status）

message<command> AdminListGatewayStatus = OperatorRequest {
}

message<response> AdminGatewayStatusListReturned {
  statuses: List<GatewayStatusView>
}

message<command> AdminCreateGatewayInstance = OperatorRequest {
  gateway_name: String
}

message<response> AdminGatewayInstanceReturned {
  instance: GatewayInstance
}

message<command> AdminBindGatewayCustomer = OperatorRequest {
  gateway_id: String
  customer_id: String
}

message<response> AdminGatewayCustomerBindingReturned {
  binding: GatewayCustomerBinding
}

message<command> AdminQueryHostInventory = OperatorRequest {
  tenant_id: String?
  environment_id: String?
  host_name: String?
}

message<response> AdminHostInventoryReturned {
  hosts: HostInventory[]
}

message<command> AdminViewHostRuntimeState = OperatorRequest {
  host_id: String
}

message<response> AdminHostRuntimeStateReturned {
  runtime: HostRuntimeState
}

message<command> AdminViewNetworkTopology = OperatorRequest {
}

message<response> AdminNetworkTopologyReturned {
  segments: NetworkSegment[]
}

message<command> AdminViewServiceTopology = OperatorRequest {
  business_id: String?
  service_id: String?
}

message<response> AdminServiceTopologyReturned {
  services: ServiceEntity[]
}

message<command> AdminViewSoftwareVulnerabilities = OperatorRequest {
  software_id: String?
  host_id: String?
}

message<response> AdminSoftwareVulnerabilitiesReturned {
  findings: SoftwareVulnerabilityFinding[]
}

message<command> AdminViewEffectiveResponsibility = OperatorRequest {
  host_id: String
}

message<response> AdminEffectiveResponsibilityReturned {
  responsibility: EffectiveHostResponsibility
}

// ── 实例 / 运行视图 ──

message<command> AdminListGatewayInstances = OperatorRequest {
}

message<response> AdminGatewayInstanceListReturned {
  instances: List<GatewayInstance>
}

message<command> AdminGetGatewayUptime {
  gateway_id: String
}

message<response> AdminGatewayUptimeReturned {
  gateway_id: String
  window: String
  uptime: Float?
}

message<command> AdminGetGatewayHistory {
  gateway_id: String
}

message<response> AdminGatewayHistoryReturned {
  gateway_id: String
  window: String
  step_seconds: Int
  samples: List<GatewayHistorySample>
}

struct GatewayHistorySample {
  at: Int
  online: Float?
  memory_bytes: Int?
  cpu_percent: Float?
}

message<command> AdminGetAgentHistory {
  gateway_id: String
  agent_id: String
}

message<response> AdminAgentHistoryReturned {
  agent_id: String
  gateway_id: String
  window: String
  samples: List<AgentHistorySample>
}

struct AgentHistorySample {
  at: Int
  online: Float?
  memory_bytes: Int?
  cpu_percent: Float?
  admin_latency_ms: Int?
}

message<command> AdminListGatewayAgents {
  gateway_id: String
}

message<response> AdminGatewayAgentsReturned {
  agents: List<AgentRuntimeStatusView>
}

message<command> AdminGetGatewayLifecycle {
  gateway_id: String
}

message<response> AdminGatewayLifecycleReturned {
  events: List<GatewayLifecycleEvent>
}

struct GatewayLifecycleEvent {
  gateway_id: String
  from_state: String?
  to_state: String
  at: DateTime
}

message<command> AdminGetGatewayInitialConfig {
  instance_id: String
}

// ── 版本发布 / 升级计划 ──

message<command> AdminPublishRelease = OperatorRequest {
  component: String
  version: String
  artifact_url: String
}

message<response> AdminReleaseReturned {
  version: String
  artifact_url: String
  status: String
  published_at: DateTime
}

message<command> AdminListReleases {
  component: String
}

message<response> AdminReleasesReturned {
  releases: List<AdminReleaseReturned>
}

message<command> AdminCreateUpgradePlan = OperatorRequest {
  targets: List<UpgradeTarget>
  gateway_ids: List<String>
  steps: List<UpgradeStep>
}

message<command> AdminListUpgradePlans {
}

message<command> AdminApproveUpgradePlan {
  plan_id: String
  approved_by: String
}

message<response> AdminUpgradePlanReturned {
  plan: UpgradePlan
}

message<response> AdminUpgradePlansReturned {
  plans: List<UpgradePlan>
}

// ── 接口 ──

interface WarpInsightCenterAdminInterface {
  meta {
    label zh "WarpInsightCenter 管理接口"
    label en "WarpInsightCenter Admin Interface"
    summary zh "面向管理员的 WarpInsightCenter 管理接口，承载网关列表/策略编排与网关实例管理。"
    tag "center"
    tag "admin-facing"
    tag "management"
    tag "http"
    tag "interface"
  }

  entry AdminViewGatewayList {
    actor GatewayOperator
    output AdminGatewayListReturned
    calls AdminViewGatewayListFlow
  }

  entry AdminDispatchGlobalPolicy {
    actor PlatformMaintenanceEngineer
    output AdminGlobalPolicyDispatchReturned
    calls AdminDispatchGlobalPolicyFlow
  }

  entry AdminShowGatewayStatus {
    actor CustomerServiceEngineer
    output AdminGatewayStatusReturned
    calls AdminShowGatewayStatusFlow
  }

  entry AdminListGatewayStatus {
    actor CustomerServiceEngineer
    output AdminGatewayStatusListReturned
    calls AdminListGatewayStatusFlow
  }

  entry AdminCreateGatewayInstance {
    actor CustomerServiceEngineer
    output AdminGatewayInstanceReturned
    calls AdminCreateGatewayInstanceFlow
  }

  entry AdminBindGatewayCustomer {
    actor CustomerServiceEngineer
    output AdminGatewayCustomerBindingReturned
    calls AdminBindGatewayCustomerFlow
  }

  entry AdminListGatewayInstances {
    actor PlatformMaintenanceEngineer
    output AdminGatewayInstanceListReturned
    calls AdminListGatewayInstancesFlow
  }

  entry AdminGetGatewayUptime {
    actor PlatformMaintenanceEngineer
    output AdminGatewayUptimeReturned
    calls AdminGetGatewayUptimeFlow
  }

  entry AdminGetGatewayHistory {
    actor PlatformMaintenanceEngineer
    output AdminGatewayHistoryReturned
    calls AdminGetGatewayHistoryFlow
  }

  entry AdminGetAgentHistory {
    actor PlatformMaintenanceEngineer
    output AdminAgentHistoryReturned
    calls AdminGetAgentHistoryFlow
  }

  entry AdminListGatewayAgents {
    actor PlatformMaintenanceEngineer
    output AdminGatewayAgentsReturned
    calls AdminListGatewayAgentsFlow
  }

  entry AdminGetGatewayLifecycle {
    actor PlatformMaintenanceEngineer
    output AdminGatewayLifecycleReturned
    calls AdminGetGatewayLifecycleFlow
  }

  entry AdminGetGatewayInitialConfig {
    actor PlatformMaintenanceEngineer
    output GatewayInitialConfigReturned
    calls AdminGetGatewayInitialConfigFlow
  }

  entry AdminPublishRelease {
    actor PlatformMaintenanceEngineer
    output AdminReleaseReturned
    calls AdminPublishReleaseFlow
  }

  entry AdminListReleases {
    actor PlatformMaintenanceEngineer
    output AdminReleasesReturned
    calls AdminListReleasesFlow
  }

  entry AdminCreateUpgradePlan {
    actor PlatformMaintenanceEngineer
    output AdminUpgradePlanReturned
    calls AdminCreateUpgradePlanFlow
  }

  entry AdminListUpgradePlans {
    actor PlatformMaintenanceEngineer
    output AdminUpgradePlansReturned
    calls AdminListUpgradePlansFlow
  }

  entry AdminApproveUpgradePlan {
    actor PlatformMaintenanceEngineer
    output AdminUpgradePlanReturned
    calls AdminApproveUpgradePlanFlow
  }
}
