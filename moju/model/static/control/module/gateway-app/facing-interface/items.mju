// Module: GatewayFacingInterface — Gateway 侧服务接口
//
// WarpInsightCenter 面向各 WarpGateway 实例暴露的接入入口。
// 请求消息（GetGatewayInitialConfig / ReportGatewayStatus）与结果结构
// （GatewayInitialConfig / GatewayStatusAccepted）由 GatewaySupervision 建模，
// 本接口引用它们作为 wire 契约，并定义响应消息与接入流程。

message<command> ReportAgentStatus {
  gateway_id: String
  agents: List<AgentRuntimeStatus>
}

message<response> AgentStatusAcceptedReturned {
  gateway_id: String
  agents_accepted: Int
}

interface WarpInsightCenterGatewayInterface {
  meta {
    label zh "WarpInsightCenter 网关接入接口"
    label en "WarpInsightCenter Gateway Access Interface"
    summary zh "WarpGateway 实例安装后主动访问的接入入口，获取初始配置并定期上报状态，供 WarpInsightCenter 全局聚合与控制。"
    tags "gateway", "gateway-facing", "bootstrap", "status", "http", "interface"
  }

  entry RegisterGateway {
    actor WarpGateway
    output GatewayEnrollmentResult
  }

  entry GetGatewayInitialConfig {
    actor WarpGateway
    output GatewayInitialConfig
  }

  entry ReportGatewayStatus {
    actor WarpGateway
    output GatewayStatusAccepted
  }

  entry RenewGatewayCredential {
    actor WarpGateway
    output GatewayCredentialBundle
  }

  entry ReportAgentStatus {
    actor WarpGateway
    output AgentStatusAcceptedReturned
  }

  entry VerifyGatewayCredential {
    actor WarpGateway
    output GatewayCredentialVerificationResult
  }

  entry InitializeGatewayViaUrl {
    actor WarpGateway
    output GatewayInitialConfig
  }
}

flow GetGatewayInitialConfigFlow {
  meta {
    label zh "置备 Gateway"
    label en "Provision Gateway Flow"
    summary zh "未初始化网关持一次性 BootstrapToken 调 initial-config：校验并消费引导 Token → 中心签发注册凭据（RegistToken）并落 enrollment → 构建 config.toml（携带信任包、引用注册 Token）。初始化后以运行期凭据重取同一配置。"
    tags "gateway", "bootstrap", "config", "provisioning"
  }

  actor WarpGateway

  lane WarpGateway for Control.GatewayApp.Application
  lane WarpInsightCenter for Control.InsightCenterApp.WarpInsightCenter

  depends GatewayIdentity, GatewayBootstrapToken

  creates GatewayInitialConfig
  creates GatewayEnrollmentToken

  // 入口：WarpGateway 持一次性 bootstrap 调 init-url（by 声明 trigger）。
  step CallInitUrl in WarpGateway by GetGatewayInitialConfig {
  }

  // ① 中心校验并一次性消费引导 Token（Bearer bootstrap）：比对 token_hash、校验 gateway_id 与
  // instance_id 绑定；消费后 status → Consumed、used_count+1；仅未初始化（Provisioned）实例可 init，
  // 防重放与重复置备。
  step ValidateBootstrapToken in WarpInsightCenter {
  }

  // ② 中心基于引导 Token 校验结果签发注册凭据 RegistToken，落 enrollment token（hash）供 /register 消费。
  // instance_id 用 fixture 值，与 AdminCreateGatewayInstanceFlow 创建实例的 instance_id 按约定对齐。
  step DeriveRegistToken in WarpInsightCenter {
    create GatewayEnrollmentToken {
      token_id = "enroll-regist-001"
      gateway_id = "gateway-issued"
      instance_id = "gw-inst-001"
      token_hash = "sha256:regist-token-hash"
      max_uses = 1
      used_count = 0
      status = "Active"
      issued_at = GetGatewayInitialConfig.requested_at
      expires_at = "2026-08-16T00:00:00Z"
    }
  }

  // ③ 中心构建初始配置：config 绑定网关身份与实例、注册 Token 引用，携带控制中心信任包（公钥）。
  step BuildInitialConfig in WarpInsightCenter {
    create GatewayInitialConfig {
      gateway_id = "gateway-issued"
      instance_id = "gw-inst-001"
      control_center_endpoint = "https://center.warpinsight.example"
      trust_bundle = ControlCenterTrustBundle
      server_tls_required = true
      protocol_version = "1.0"
      enrollment_token_id = "enroll-regist-001"
    }
  }
}

verify ProvisionIssuedVerified for flow GetGatewayInitialConfigFlow {
  given {
    GetGatewayInitialConfig.requested_at = "2026-07-04T00:00:00Z"
  }

  when GetGatewayInitialConfig

  expect {
    GatewayEnrollmentToken.token_id == "enroll-regist-001"
    GatewayEnrollmentToken.status == "Active"
    GatewayInitialConfig.enrollment_token_id == "enroll-regist-001"
  }
}

flow InitializeGatewayViaUrlFlow {
  meta {
    label zh "通过 URL 初始化"
    label en "Initialize Gateway Via Url Flow"
    summary zh "WarpGateway 持控制中心初始化 URL：校验 URL（指向 initial-config 入口）→ 构建初始配置（携带信任包）→ 完成初始化；非法 URL 拒绝。"
    tags "gateway", "bootstrap", "initialize", "config"
  }

  actor WarpGateway
  trigger InitializeGatewayViaUrl

  creates GatewayInitialConfig

  // ① 校验初始化 URL：指向 initial-config 入口则进入构建，否则拒绝初始化。
  step ValidateInitUrl {
    match {
      contains(InitializeGatewayViaUrl.init_url, "initial-config") -> BuildInitialConfig
      _ -> RejectInitialization
    }
  }

  // ② 构建初始配置：控制端点 = 提交的 URL，config 携带控制中心信任包（公钥），绑定实例。
  step BuildInitialConfig {
    create GatewayInitialConfig {
      gateway_id = "gateway-issued"
      instance_id = "gw-inst-001"
      control_center_endpoint = InitializeGatewayViaUrl.init_url
      trust_bundle = ControlCenterTrustBundle
      server_tls_required = true
      protocol_version = "1.0"
      enrollment_token_id = "gw-enroll-001"
    }
  }

  // ③ 应用初始配置并重启，以新配置（控制端点/信任包/协议）进入运行态。
  step Restart {
  }

  // ④ 正常结束 flow。
  step<stop> Finish {
  }

  // ⑤ 非法初始化 URL：提前退出 flow（拒绝初始化）。
  step<exit> RejectInitialization {
  }
}

flow ReportGatewayStatusFlow {
  meta {
    label zh "上报 Gateway 状态"
    label en "Report Gateway Status Flow"
    tags "gateway", "status"
  }

  actor WarpGateway

  lane WarpGateway for Control.GatewayApp.Application
  lane WarpInsightCenter for Control.InsightCenterApp.WarpInsightCenter

  creates GatewayStatusAccepted

  // 入口：WarpGateway 周期上报运行状态（by 声明 trigger）。
  step ReportStatus in WarpGateway by ReportGatewayStatus {
  }

  // 中心接收并落库状态，返回回执。
  step AcceptStatusReport in WarpInsightCenter {
    create GatewayStatusAccepted {
      gateway_id = ReportGatewayStatus.gateway_id
      instance_id = ReportGatewayStatus.instance_id
      accepted_at = ReportGatewayStatus.reported_at
    }
  }
}

flow ReportAgentStatusFlow {
  actor WarpGateway
  trigger ReportAgentStatus

  
}
