module<logic> AgentRegistration {
  meta {
    label zh "注册与引导逻辑"
    label en "AgentEnrollment Service"
    summary zh "负责 Agent 安装代码命令与 Agentd 注册流程。"
    tag "control"
    tag "enrollment"
  }

  layer Domain
  owns GetAgentInstallCode
  owns AgentdRegistrationFlow
  depends AgentEnrollment
  depends AgentIdentity
  depends AgentRegistry
  responsible_for "注册逻辑：安装代码命令、Agentd 注册流程（校验 token、签发身份/凭据、构建初始配置与策略绑定），读取 AgentEnrollment/AgentIdentity/AgentRegistry 实体事实。"
}
