module<logic> Gateway.InstanceManagement {
  meta {
    label zh "网关实例管理"
    label en "Gateway Instance Management"
    summary zh "负责 WarpGateWay 实例的北向管理命令：状态视图、实例创建与客户绑定。"
    tags "control", "gateway", "instance"
  }

  layer Domain
  owns ShowGatewayStatus
  owns CreateGatewayInstance
  owns BindGatewayCustomer
  owns GatewayInstanceLifecycleState
  depends Control.Gateway.Supervision
  responsible_for "网关实例管理：展示网关状态、创建管理实例、绑定客户，读取 GatewaySupervision 实体事实。"
}

// Module: GatewayInstanceManagement — 网关实例管理
//
// WarpGateWay 实例的北向管理命令（管理员视角），实体事实由 GatewaySupervision 承载。

command ShowGatewayStatus {
  meta {
    label zh "展示 Gateway 状态"
    label en "Show Gateway Status"
    summary zh "全局操作者查看各 WarpGateWay 实例的聚合状态视图。"
    tags "gateway", "status", "global-view"
  }

  requested_by: String
}

command CreateGatewayInstance {
  meta {
    label zh "创建 GateWay 管理实例"
    label en "Create Gateway Instance"
    summary zh "客户服务工程师在 WarpInsightCenter 创建 GateWay 管理实例。"
    tags "gateway", "provisioning"
  }

  gateway_name: String
  requested_by: String
  requested_at: DateTime
}

command BindGatewayCustomer {
  meta {
    label zh "绑定客户 ID"
    label en "Bind Gateway Customer"
    summary zh "客户服务工程师把 GateWay 管理实例绑定到客户 ID，建立实例与客户的归属关系。"
    tags "gateway", "provisioning", "customer"
  }

  gateway_id: String
  customer_id: String
  requested_by: String
  requested_at: DateTime
}
