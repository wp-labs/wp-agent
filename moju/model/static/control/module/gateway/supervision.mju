module<logic> Gateway.Supervision {
  meta {
    label zh "网关注册与状态"
    label en "Gateway Supervision"
    summary zh "负责 WarpGateWay 实例在 WarpInsightCenter 的监管逻辑：初始配置获取、状态上报、状态、实例、客户绑定、列表视图与策略下发回执；实例管理命令由 GatewayInstanceManagement 承载。"
    tag "control"
    tag "gateway"
    tag "supervision"
  }

  layer Domain
  owns GatewayInitialConfig
  owns GatewayStatusAccepted
  owns GatewayStatusView
  owns GatewayInstance
  owns GatewayCustomerBinding
  owns GatewayListView
  owns GlobalPolicyDispatch
  owns GetGatewayInitialConfig
  owns ReportGatewayStatus
  responsible_for "WarpGateWay 上级聚合：初始配置获取、状态上报、状态回执、状态视图、管理实例、客户绑定、列表视图与策略下发回执；网关身份由 GateWayIdentity 表达，实例管理命令由 GatewayInstanceManagement 承载。"
}

// Module: GatewaySupervision — WarpGateWay 上级聚合
// 覆盖 WarpGateWay 实例接入 WarpInsightCenter 的初始配置获取、状态上报与状态/实例/客户/列表视图实体。
// 实例管理命令由 GatewayInstanceManagement 承载。

struct GatewayInitialConfig {
  meta {
    label zh "Gateway 初始配置"
    label en "Gateway Initial Config"
    summary zh "WarpGateWay 实例接入 WarpInsightCenter 后获取的初始运行配置，包括控制中心地址、策略版本与遥测输出。"
    tag "gateway"
    tag "config"
  }

  control_center_endpoint: String
  policy_version: String
  telemetry_output: String
}

struct GatewayStatusAccepted {
  meta {
    label zh "Gateway 状态已接收"
    label en "Gateway Status Accepted"
    summary zh "WarpInsightCenter 接收 Gateway 状态上报后的确认回执。"
    tag "gateway"
    tag "status"
  }

  gateway_id: String
  instance_id: String
  accepted_at: DateTime
}

struct GatewayStatusView {
  meta {
    label zh "Gateway 状态视图"
    label en "Gateway Status View"
    summary zh "中心监管视角：WarpInsightCenter 查看单个 WarpGateWay 实例的在线状态、版本、健康状态和最后上报时间（对应网关状态上报聚合）。"
    tag "gateway"
    tag "status"
    tag "global-view"
  }

  gateway_id: String
  instance_id: String
  version: String
  status: String
  health: String
  memory_bytes: Int?
  cpu_percent: Float?
  last_seen_at: DateTime
}

struct GatewayInstance {
  meta {
    label zh "GateWay 管理实例"
    label en "Gateway Instance"
    summary zh "WarpInsightCenter 创建的 GateWay 管理实例，作为后续接入与状态聚合的管理对象。"
    tag "gateway"
    tag "provisioning"
  }

  gateway_id: String
  instance_id: String
  status: String
  created_at: DateTime
}

struct GatewayCustomerBinding {
  meta {
    label zh "GateWay 客户绑定"
    label en "Gateway Customer Binding"
    summary zh "GateWay 管理实例与客户 ID 的绑定关系，作为实例归属客户的管理依据。"
    tag "gateway"
    tag "provisioning"
    tag "customer"
  }

  gateway_id: String
  customer_id: String
  status: String
  bound_at: DateTime
}

struct GatewayListView {
  meta {
    label zh "网关列表视图"
    label en "Gateway List View"
    summary zh "WarpInsightCenter 展示的 WarpGateWay 实例列表聚合视图：总数、在线、降级与离线计数。"
    tag "center"
    tag "gateway"
    tag "list"
  }

  gateway_count: Int
  online_count: Int
  degraded_count: Int
  offline_count: Int
  updated_at: DateTime
}

struct GlobalPolicyDispatch {
  meta {
    label zh "全局策略下发回执"
    label en "Global Policy Dispatch"
    summary zh "WarpInsightCenter 下发全局策略后的派发回执，记录策略版本、目标数与下发状态。"
    tag "center"
    tag "policy"
  }

  unique dispatch_id: String
  policy_version: String
  target_count: Int
  status: String
  dispatched_at: DateTime
}

// ── 网关接入（forGateway：WarpGateWay 实例 → WarpInsightCenter） ──

message<command> GetGatewayInitialConfig {
  instance_id: String
  requested_at: DateTime
}

message<command> ReportGatewayStatus {
  gateway_id: String
  instance_id: String
  version: String
  status: String
  health: String
  memory_bytes: Int?
  cpu_percent: Float?
  reported_at: DateTime
}
