module<logic> InsightCenter.PlatformRelease {
  meta {
    label zh "平台版本发布"
    label en "Platform Release"
    summary zh "负责 WarpAgentd 与 WarpGateWay 新版本的发布。"
    tags "control", "release"
  }

  layer Domain
  owns PublishWarpAgentd
  owns WarpAgentdRelease
  owns PublishWarpGateWay
  owns WarpGateWayRelease
  owns CreateUpgradePlan
  owns UpgradePlan
  owns UpgradeTarget
  owns UpgradeStep
  owns ApproveUpgradePlan
  owns UpgradePlanApproval
  owns ArtifactStorageKind
  owns ArtifactMirror
  responsible_for "平台版本发布与升级：WarpAgentd 与 WarpGateWay 新版本发布记录（含制品镜像）、升级计划与批准。"
}

// Module: PlatformRelease — 平台版本发布
// 覆盖 WarpAgentd / WarpGateWay 新版本的发布。

command PublishWarpAgentd {
  meta {
    label zh "发布 WarpAgentd"
    label en "Publish WarpAgentd"
    summary zh "平台维护工程师在 WarpInsightCenter 发布 WarpAgentd 新版本，供各 WarpGateWay 实例拉取升级。"
    tags "release", "warp-agentd"
  }

  version: String
  artifact_url: String
  requested_by: String
  requested_at: DateTime
}

struct WarpAgentdRelease {
  meta {
    label zh "WarpAgentd 发布记录"
    label en "WarpAgentd Release"
    summary zh "WarpAgentd 新版本的发布记录，包含版本号、产物地址与发布状态。"
    tags "release", "warp-agentd"
  }

  version: String
  artifact_url: String
  status: String
  published_at: DateTime
}

command PublishWarpGateWay {
  meta {
    label zh "发布 WarpGateWay"
    label en "Publish WarpGateWay"
    summary zh "平台维护工程师在 WarpInsightCenter 发布 WarpGateWay 新版本，供各 WarpGateWay 管理实例升级。"
    tags "release", "warp-gateway"
  }

  version: String
  artifact_url: String
  requested_by: String
  requested_at: DateTime
}

struct WarpGateWayRelease {
  meta {
    label zh "WarpGateWay 发布记录"
    label en "WarpGateWay Release"
    summary zh "WarpGateWay 新版本的发布记录，包含版本号、产物地址与发布状态。"
    tags "release", "warp-gateway"
  }

  version: String
  artifact_url: String
  status: String
  published_at: DateTime
}

// 制品存储后端：本地文件或云对象存储（S3 兼容 / MinIO）。
variant ArtifactStorageKind {
  meta {
    label zh "制品存储类型"
    label en "Artifact Storage Kind"
    summary zh "制品镜像的存储后端：本地文件目录，或云对象存储（S3 兼容 / MinIO）。"
    tags "release", "artifact", "storage"
  }

  LocalFile
  ObjectStorage
}

// 制品镜像记录：发布时把外部制品（GitHub / 制品库，访问慢）下载后镜像到本地文件或
// 云对象存储，`stored_url` 为快的下载地址（供升级拉取），避免直接依赖慢源分发。
struct ArtifactMirror {
  meta {
    label zh "制品镜像记录"
    label en "Artifact Mirror"
    summary zh "版本发布时将外部制品镜像到本地文件或云对象存储，记录原始地址、镜像后地址与存储后端。"
    tags "release", "artifact", "mirror"
  }

  component: String
  version: String
  source_url: String
  stored_url: String
  storage_kind: ArtifactStorageKind
  mirrored_at: DateTime
}

// 一个升级目标：组件 + 目标版本（升级计划可含多个目标，如 WarpAgentd v2.5.0 + WarpGateWay v3.1.0）。
struct UpgradeTarget {
  meta {
    label zh "升级目标"
    label en "Upgrade Target"
    summary zh "升级计划中的单个目标：目标组件与目标版本，可多选。"
    tags "release", "upgrade"
  }

  component: String
  target_version: String
}

// 升级执行步骤：手动分批（每步升级范围内的部分网关），实现滚动升级。
struct UpgradeStep {
  meta {
    label zh "升级执行步骤"
    label en "Upgrade Step"
    summary zh "升级计划中的执行步骤，指定本批升级的网关集合与步骤状态。"
    tags "release", "upgrade", "rollout"
  }

  step_index: Int
  gateway_ids: List<String>
  status: String
}

command CreateUpgradePlan {
  meta {
    label zh "创建升级计划"
    label en "Create Upgrade Plan"
    summary zh "平台维护工程师在 WarpInsightCenter 创建升级计划，指定多组件目标版本、网关范围与分批执行步骤。"
    tags "release", "upgrade"
  }

  targets: List<UpgradeTarget>
  gateway_ids: List<String>
  steps: List<UpgradeStep>
  requested_by: String
  requested_at: DateTime
}

struct UpgradePlan {
  meta {
    label zh "升级计划"
    label en "Upgrade Plan"
    summary zh "WarpAgentd / WarpGateWay 的升级计划，包含多组件目标版本、升级范围、分批执行步骤与状态。"
    tags "release", "upgrade"
  }

  plan_id: String
  targets: List<UpgradeTarget>
  target_count: Int
  status: String
  created_at: DateTime
  steps: List<UpgradeStep>
}

command ApproveUpgradePlan {
  meta {
    label zh "批准升级计划"
    label en "Approve Upgrade Plan"
    summary zh "客户服务工程师批准升级计划，同意对指定范围内的 WarpAgentd / WarpGateWay 执行升级。"
    tags "release", "upgrade"
  }

  plan_id: String
  approved_by: String
  approved_at: DateTime
}

struct UpgradePlanApproval {
  meta {
    label zh "升级计划批准"
    label en "Upgrade Plan Approval"
    summary zh "升级计划的批准记录，包含计划、批准人、批准时间与状态。"
    tags "release", "upgrade"
  }

  plan_id: String
  status: String
  approved_by: String
  approved_at: DateTime
}
