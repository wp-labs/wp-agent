module<logic> AgentCredential {
  meta {
    label zh "Agent 身份逻辑"
    label en "Agent AgentIdentity Service"
    summary zh "负责 Agent 凭据续期与校验命令、校验流程。"
    tag "control"
    tag "identity"
  }

  layer Domain
  owns RenewAgentCredential
  owns VerifyAgentCredential
  owns VerifyAgentCredentialFlow
  depends AgentIdentity
  responsible_for "Agent 身份逻辑：凭据续期、凭据校验命令与校验流程，读取 AgentIdentity 实体事实。"
}
