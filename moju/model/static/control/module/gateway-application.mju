module<service> GateWayApplication {
  meta {
    label zh "网关应用编排"
    label en "GateWay Application Orchestration"
    summary zh "负责 WarpGateWay 应用层的用例级编排：网关总览、Agent 舰队指令下发等命令与流程，组合控制面与网关管理 Domain 模块完成编排。"
    tag "control"
    tag "gateway"
    tag "application"
  }

  layer Application
  owns ViewGateWayOverview
  owns ViewGateWayOverviewFlow
  owns DispatchAgentFleetCommand
  owns DispatchAgentFleetCommandFlow
  depends AgentEnrollment, AgentRegistration, AgentIdentity, AgentCredential
  depends AgentStatus, AgentCommand
  depends Protocol, AgentRegistry
  depends GateWayManagement, GateWayManagement
  responsible_for "网关应用编排：网关总览视图、Agent 舰队指令派发与回执，组合控制面与网关管理 Domain 模块完成编排。"
}
