module<logic> AgentStatus {
  meta {
    label zh "Agentd 状态管理"
    label en "Agentd Status Management"
    summary zh "负责 Agentd 实例、运行状态查询、在线状态视图和管理端状态展示所需的状态聚合。"
    tag "control"
    tag "agentd"
    tag "status"
  }

  layer Domain
  owns AgentInstance
  owns ShowAgentRuntimeStatus
  owns GetAgentOverview
  owns AgentRuntimeStatusView
  owns AgentOverviewMetrics
  owns RecentOnlineRegisteredAgent
  owns AgentOverview
  owns LookupAgentRegistryEntry
  owns QueryAgentCapabilityIndex
  responsible_for "Agent 状态与登记查询：实例、版本、在线时间、健康状态、运行状态视图、Agent 总览、登记记录与能力索引查询。"
}
