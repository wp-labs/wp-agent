// Module: WarpInsightCenter — 全局控制中心应用编排
//
// WarpInsightCenter 的 Application 层编排：网关舰队聚合、全局策略下发等
// 用例级命令与流程，组合各 Domain 模块的事实完成编排。

command ViewGatewayFleet {
  meta {
    label zh "查看网关舰队"
    label en "View Gateway Fleet"
    summary zh "全局操作者查看接入 WarpInsightCenter 的 WarpGateWay 实例舰队聚合视图。"
    tag "center"
    tag "gateway"
    tag "fleet"
  }

  requested_by: String
}

command DispatchGlobalPolicy {
  meta {
    label zh "下发全局策略"
    label en "Dispatch Global Policy"
    summary zh "平台维护工程师在 WarpInsightCenter 向指定 WarpGateWay 实例舰队下发全局策略版本。"
    tag "center"
    tag "policy"
  }

  policy_version: String
  gateway_ids: List<String>
  requested_by: String
}

flow ViewGatewayFleetFlow {
  meta {
    label zh "查看网关舰队"
    label en "View Gateway Fleet Flow"
    summary zh "聚合各 WarpGateWay 实例的在线、降级与离线状态，生成舰队总览视图。"
    tag "center"
    tag "gateway"
    tag "fleet"
  }

  actor GatewayOperator
  trigger ViewGatewayFleet

  creates GatewayFleetView

  step BuildFleetView {
    create GatewayFleetView {
      gateway_count = 3
      online_count = 2
      degraded_count = 1
      offline_count = 0
      updated_at = "now"
    }
  }
}

flow DispatchGlobalPolicyFlow {
  meta {
    label zh "下发全局策略"
    label en "Dispatch Global Policy Flow"
    summary zh "向目标 WarpGateWay 舰队下发指定策略版本，并生成派发回执。"
    tag "center"
    tag "policy"
  }

  actor PlatformMaintenanceEngineer
  trigger DispatchGlobalPolicy

  creates GlobalPolicyDispatch

  step DispatchPolicy {
    create GlobalPolicyDispatch {
      dispatch_id = DispatchGlobalPolicy.requested_by
      policy_version = DispatchGlobalPolicy.policy_version
      target_count = DispatchGlobalPolicy.gateway_ids
      status = "accepted"
      dispatched_at = "now"
    }
  }
}
