// Module: GateWayManagement — 网关自身管理域
//
// WarpGateWay 控制平台自身的领域事实：网关实例、控制面配置与健康状态。
// 区别于 insightcenter 层 GatewaySupervision 从中心侧对网关的接入与聚合。

struct WarpGateWayInstance {
  meta {
    label zh "WarpGateWay 实例"
    label en "WarpGateWay Instance"
    summary zh "WarpGateWay 控制平台自身的一次运行实例状态，包含 boot id、版本、启动时间与最后在线时间。"
    tag "gateway"
    tag "instance"
  }

  unique gateway_id: String
  instance_id: String
  boot_id: String
  version: String
  started_at: DateTime
  last_seen_at: DateTime
}

struct GateWayControlConfig {
  meta {
    label zh "网关控制面配置"
    label en "GateWay Control Config"
    summary zh "WarpGateWay 控制平台的对外访问与控制面配置，包括 advertise、enrollment、gateway 与 telemetry 地址。"
    tag "gateway"
    tag "config"
  }

  unique config_id: String
  gateway_id: String
  advertise_url: String
  enrollment_url: String
  gateway_url: String
  telemetry_url: String
  updated_at: DateTime
}

struct GateWayHealth {
  meta {
    label zh "网关健康状态"
    label en "GateWay Health"
    summary zh "WarpGateWay 控制平台自身的健康状态与最近上报时间。"
    tag "gateway"
    tag "health"
  }

  gateway_id: String
  status: String
  reported_at: DateTime
}

struct GateWayManagementStateView {
  meta {
    label zh "网关管理状态视图"
    label en "GateWay Management State View"
    summary zh "网关自管视角：WarpGateWay 管理员查看本机实例、控制面配置与健康状态，供本机管理控制台使用。"
    tag "gateway"
    tag "management"
    tag "self-management"
  }

  gateway_id: String
  instance_id: String
  version: String
  status: String
  config: GateWayControlConfig
  health: GateWayHealth
  last_seen_at: DateTime
}

struct GateWayOverviewView {
  meta {
    label zh "网关总览视图"
    label en "GateWay Overview View"
    summary zh "控制台总览视角：网关控制台 dashboard 聚合网关自身状态与所辖 Agent 舰队汇总。"
    tag "gateway"
    tag "overview"
    tag "console"
  }

  gateway_id: String
  agent_total: Int
  agent_online: Int
  agent_unhealthy: Int
  status: String
  updated_at: DateTime
}

command ViewGateWayManagementState {
  meta {
    label zh "查看网关管理状态"
    label en "View GateWay Management State"
    summary zh "管理员查看 WarpGateWay 控制平台自身的实例、控制面配置与健康状态聚合视图。"
    tag "gateway"
    tag "management"
  }

  requested_by: String
}
