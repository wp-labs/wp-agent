// Module: ServiceTopology — business / system / service 拓扑实体
// 来源：doc/design/center/models/business-system-service-topology-model.md
//
// 中心侧资源目录模型与关系图谱模型的业务拓扑扩展子模型的一部分：
// business / system / service / service instance 分层；ServiceEndpoint（稳定入口）
// 与 ServiceInstanceEndpoint（动态运行地址）分开；ServiceDependency（逻辑依赖）
// 与 NetworkAttachment（拓扑连接）分开。

struct BusinessDomain {
  meta {
    label zh "业务域"
    label en "Business Domain"
    summary zh "业务域对象，作为业务拓扑的根目录层。"
    tag "center"
    tag "topology"
    tag "business"
  }

  unique business_id: String
  tenant_id: String
  name: String
  code: String?
  description: String?
  lifecycle_state: String?
}

struct SystemBoundary {
  meta {
    label zh "系统边界"
    label en "System Boundary"
    summary zh "业务下的系统边界，一个业务可包含多个系统，支持父系统表达更粗/更细的边界。"
    tag "center"
    tag "topology"
    tag "business"
  }

  unique system_id: String
  business_id: String
  tenant_id: String
  name: String
  code: String?
  description: String?
  parent_system_id: String?
}

struct BusinessSubsystem {
  meta {
    label zh "业务子系统"
    label en "Business Subsystem"
    summary zh "系统内部的业务子系统，作为服务归属的目录层（与 MoJu 运行时 subsystem 概念区分）。"
    tag "center"
    tag "topology"
    tag "business"
  }

  unique subsystem_id: String
  system_id: String
  tenant_id: String
  name: String
  code: String?
  description: String?
}

struct ServiceEntity {
  meta {
    label zh "逻辑服务"
    label en "Service Entity"
    summary zh "逻辑服务定义，不是运行实例；一个服务可被部署为多个实例。"
    tag "center"
    tag "topology"
    tag "service"
  }

  unique service_id: String
  tenant_id: String
  business_id: String?
  system_id: String?
  subsystem_id: String?
  namespace: String?
  name: String
  service_type: ServiceType
  language: String?
  lifecycle_state: String?
}

variant ServiceType {
  meta {
    label zh "服务类型"
    label en "Service Type"
    summary zh "逻辑服务的类型：API、worker、调度器、网关或数据库适配器。"
  }

  Api
  Worker
  Scheduler
  Gateway
  DatabaseAdapter
}

struct ServiceInstance {
  meta {
    label zh "服务实例"
    label en "Service Instance"
    summary zh "服务的运行副本，桥接业务服务与底层运行对象，最终落到 PodInventory / ProcessRuntimeState / HostInventory。"
    tag "center"
    tag "topology"
    tag "service"
  }

  unique service_instance_id: String
  service_id: String
  runtime_type: ServiceRuntimeType
  pod_id: String?
  process_id: String?
  host_id: String?
  version: String?
  state: ServiceInstanceLifecycleState?
  started_at: DateTime?
  last_seen_at: DateTime
}

variant ServiceRuntimeType {
  meta {
    label zh "服务运行载体"
    label en "Service Runtime Type"
    summary zh "服务实例的运行载体：pod、容器、进程或虚拟机。"
  }

  Pod
  Container
  Process
  Vm
}

variant ServiceInstanceLifecycleState {
  meta {
    label zh "服务实例生命周期状态"
    label en "Service Instance Lifecycle State"
    summary zh "服务实例的当前生命周期状态。"
  }

  Running
  Stopped
  Pending
  Terminating
}

struct ServiceEndpoint {
  meta {
    label zh "服务入口地址"
    label en "Service Endpoint"
    summary zh "服务的稳定入口地址（DNS、VIP、Ingress、LB 等），一个服务可有多个入口，不等同具体实例地址。"
    tag "center"
    tag "topology"
    tag "service"
  }

  unique endpoint_id: String
  service_id: String
  endpoint_type: ServiceEndpointType
  address: String
  port: Int?
  protocol: String
  exposure_scope: ExposureScope
  valid_from: DateTime
  valid_to: DateTime?
}

variant ServiceEndpointType {
  meta {
    label zh "服务入口类型"
    label en "Service Endpoint Type"
    summary zh "服务稳定入口的类型：DNS、VIP、Ingress、负载均衡、NodePort 或外部。"
  }

  Dns
  Vip
  Ingress
  LoadBalancer
  NodePort
  External
}

variant ExposureScope {
  meta {
    label zh "暴露范围"
    label en "Exposure Scope"
    summary zh "服务入口的暴露范围：集群内、VPC 内或公网。"
  }

  ClusterInternal
  VpcInternal
  Public
}

struct ServiceInstanceEndpoint {
  meta {
    label zh "服务实例地址"
    label en "Service Instance Endpoint"
    summary zh "服务实例的当前动态运行地址（pod/host/container IP:Port）。"
    tag "center"
    tag "topology"
    tag "service"
  }

  unique instance_endpoint_id: String
  service_instance_id: String
  address: String
  port: Int
  protocol: String
  source: String
  valid_from: DateTime
  valid_to: DateTime?
}

struct ServiceDependency {
  meta {
    label zh "服务依赖"
    label en "Service Dependency"
    summary zh "服务之间的逻辑依赖关系，区分声明依赖与运行时观测依赖，与网络附件分离。"
    tag "center"
    tag "topology"
    tag "service"
  }

  unique dependency_id: String
  upstream_service_id: String
  downstream_service_id: String
  dependency_type: DependencyType
  dependency_scope: DependencyScope
  criticality: Int?
  source: String
  valid_from: DateTime
  valid_to: DateTime?
}

variant DependencyType {
  meta {
    label zh "依赖类型"
    label en "Dependency Type"
    summary zh "服务依赖的类型：同步 RPC、异步消息、数据库、缓存或外部 API。"
  }

  SyncRpc
  AsyncMq
  Database
  Cache
  ExternalApi
}

variant DependencyScope {
  meta {
    label zh "依赖来源"
    label en "Dependency Scope"
    summary zh "服务依赖的来源：架构声明或运行时观测。"
  }

  Declared
  Observed
}
