module<logic> HostResponsibilityService {
  meta {
    label zh "责任归属逻辑"
    label en "HostResponsibility Service"
    summary zh "负责主机有效责任查询与外部责任同步逻辑。"
    tags "control", "center", "responsibility"
  }

  layer Domain
  owns ViewEffectiveHostResponsibility
  owns SyncExternalResponsibility
  owns EffectiveHostResponsibility
  owns ExternalSyncCursor
  depends HostResponsibility
  responsible_for "责任归属逻辑：查看主机有效责任主体、同步外部责任关系、有效责任视图与外部同步游标，读取 HostResponsibility 实体事实。"
}
