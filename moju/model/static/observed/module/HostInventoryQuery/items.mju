command QueryHostInventory {
  meta {
    label zh "查询主机资产目录"
    label en "Query Host HostInventory"
    summary zh "安全分析师按租户、环境或主机名查询主机资产目录。"
    tags "center", "asset", "inventory"
  }

  tenant_id: String?
  environment_id: String?
  host_name: String?
  requested_by: String
}

command ViewHostRuntimeState {
  meta {
    label zh "查看主机运行状态"
    label en "View Host Runtime State"
    tags "center", "asset", "runtime-state"
  }

  host_id: String
  requested_by: String
}
