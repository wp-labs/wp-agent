struct Subject {
  meta {
    label zh "责任主体"
    label en "Subject"
    summary zh "责任归属中的"谁"：用户、团队、服务账号或厂商，优先以团队作为最终责任绑定对象。"
    tags "center", "responsibility", "subject"
  }

  unique subject_id: String
  tenant_id: String
  subject_type: SubjectType
  name: String
  external_ref: String?
  status: String
  created_at: DateTime
  updated_at: DateTime
}

variant SubjectType {
  meta {
    label zh "主体类型"
    label en "Subject Type"
    summary zh "责任主体的类型：用户、团队、服务账号或厂商。"
  }

  User
  Team
  ServiceAccount
  Vendor
}

struct HostGroup {
  meta {
    label zh "主机组"
    label en "Host Group"
    summary zh "一批主机的归属边界，作为责任归属与批量治理的中间层，按应用、业务、集群或环境继承。"
    tags "center", "responsibility", "host-group"
  }

  unique host_group_id: String
  tenant_id: String
  environment_id: String
  name: String
  group_type: HostGroupType
  parent_group_id: String?
  description: String?
  created_at: DateTime
  updated_at: DateTime
}

variant HostGroupType {
  meta {
    label zh "主机组类型"
    label en "Host Group Type"
    summary zh "主机组的归属语义：应用、业务、集群、环境或运维范围。"
  }

  Application
  Business
  Cluster
  Environment
  OpsScope
}

struct HostGroupMembership {
  meta {
    label zh "主机组成员关系"
    label en "Host Group Membership"
    summary zh "主机属于哪些组的成员关系，一台主机可属于多个组，携带生效时间与来源。"
    tags "center", "responsibility", "host-group"
  }

  host_id: String
  host_group_id: String
  membership_role: String
  source: AssignmentSource
  valid_from: DateTime
  valid_to: DateTime?
  created_at: DateTime
  updated_at: DateTime
}

struct ResponsibilityAssignment {
  meta {
    label zh "责任分配"
    label en "HostResponsibility Assignment"
    summary zh "主机或主机组到责任主体的角色分配，记录角色、主责任标记、优先级、来源与生效时间。"
    tags "center", "responsibility", "assignment"
  }

  unique assignment_id: String
  tenant_id: String
  target_type: AssignmentTargetType
  target_id: String
  role: AssignmentRole
  subject_id: String
  is_primary: Bool
  priority: Int
  source: AssignmentSource
  valid_from: DateTime
  valid_to: DateTime?
  remark: String?
  created_at: DateTime
  updated_at: DateTime
}

variant AssignmentTargetType {
  meta {
    label zh "分配目标类型"
    label en "Assignment Target Type"
    summary zh "责任分配的目标：单台主机或主机组。"
  }

  Host
  HostGroup
}

variant AssignmentRole {
  meta {
    label zh "责任角色"
    label en "Assignment Role"
    summary zh "责任角色：owner 最终归属、maintainer 日常维护、operator 操作、oncall 告警值班、security_owner 漏洞整改推进。"
  }

  Owner
  Maintainer
  Operator
  Oncall
  SecurityOwner
}

variant AssignmentSource {
  meta {
    label zh "责任来源"
    label en "Assignment Source"
    summary zh "责任分配或成员关系的来源：手工、CMDB 同步、HR 同步、Oncall 同步或规则推断。"
  }

  Manual
  CmdbSync
  HrSync
  OncallSync
  RuleDerived
}

struct ExternalIdentityLink {
  meta {
    label zh "外部身份映射"
    label en "External AgentIdentity Link"
    summary zh "内部对象与外部系统对象的稳定映射，外部 ID 与内部主键解耦，同一内部对象可持有多个来源映射。"
    tags "center", "responsibility", "external-sync"
  }

  unique link_id: String
  tenant_id: String
  system_type: ExternalSystemType
  object_type: String
  external_id: String
  external_key: String?
  internal_kind: ExternalLinkInternalKind
  internal_id: String
  status: String
  first_seen_at: DateTime
  last_seen_at: DateTime
  last_synced_at: DateTime
}

variant ExternalSystemType {
  meta {
    label zh "外部系统类型"
    label en "External System Type"
    summary zh "外部主数据来源：CMDB、LDAP、IAM、HR 或 Oncall 值班平台。"
  }

  Cmdb
  Ldap
  Iam
  Hr
  Oncall
}

variant ExternalLinkInternalKind {
  meta {
    label zh "外部映射内部对象类型"
    label en "External Link Internal Kind"
    summary zh "外部对象归一到内部的对象类型：责任主体、主机组或主机。"
  }

  Subject
  HostGroup
  Host
}
