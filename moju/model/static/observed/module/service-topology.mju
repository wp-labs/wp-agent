module<entity> ServiceTopology {
  meta {
    label zh "业务/服务拓扑实体"
    label en "Service Topology"
    summary zh "负责 business / system / service 拓扑实体：业务域、系统边界、业务子系统、逻辑服务、服务实例、服务入口与实例地址、服务依赖。"
    tag "control"
    tag "center"
    tag "topology"
    tag "service"
  }

  layer Domain
  owns BusinessDomain
  owns SystemBoundary
  owns BusinessSubsystem
  owns ServiceEntity
  owns ServiceType
  owns ServiceInstance
  owns ServiceRuntimeType
  owns ServiceInstanceLifecycleState
  owns ServiceEndpoint
  owns ServiceEndpointType
  owns ExposureScope
  owns ServiceInstanceEndpoint
  owns ServiceDependency
  owns DependencyType
  owns DependencyScope
  responsible_for "业务/服务拓扑实体：业务域、系统边界、业务子系统、逻辑服务、服务实例、服务入口与实例地址、服务依赖；查询逻辑由 TopologyQuery 承载。"
}
