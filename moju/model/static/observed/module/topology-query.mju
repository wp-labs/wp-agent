module<logic> TopologyQuery {
  meta {
    label zh "资源拓扑查询"
    label en "Resource Topology Query"
    summary zh "负责 host/pod/network 与业务/服务拓扑的查询逻辑。"
    tags "control", "center", "topology"
  }

  layer Domain
  owns ViewNetworkTopology
  owns ViewServiceTopology
  depends NetworkTopology, ServiceTopology
  responsible_for "资源拓扑查询：查看网络拓扑与业务/服务拓扑，读取 NetworkTopology / ServiceTopology 实体事实。"
}
