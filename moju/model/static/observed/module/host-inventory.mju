module<entity> HostInventory {
  meta {
    label zh "主机资源目录"
    label en "Host HostInventory"
    summary zh "负责主机资产目录（HostInventory）与主机运行态快照（HostRuntimeState）等中心侧资源目录实体。"
    tag "control"
    tag "center"
    tag "asset"
  }

  layer Domain
  owns HostInventory
  owns HostDiskInventoryItem
  owns HostNetworkInterfaceInventoryItem
  owns HostRuntimeState
  owns AgentHealth
  owns ProtectionState
  responsible_for "主机资源目录实体：主机静态资产事实、磁盘/网卡子项、主机动态运行态快照、agent 健康与保护状态；查询逻辑由 HostInventoryQuery 承载。"
}
