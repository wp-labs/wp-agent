module<entity> HostResponsibility {
  meta {
    label zh "主机责任归属"
    label en "Host HostResponsibility"
    summary zh "负责责任主体、主机组、成员关系、责任分配、有效责任视图与外部系统（CMDB/LDAP/HR/Oncall）责任同步等治理关系事实。"
    tag "control"
    tag "center"
    tag "responsibility"
  }

  layer Domain
  owns Subject
  owns SubjectType
  owns HostGroup
  owns HostGroupType
  owns HostGroupMembership
  owns ResponsibilityAssignment
  owns AssignmentTargetType
  owns AssignmentRole
  owns AssignmentSource
  owns ExternalIdentityLink
  owns ExternalSystemType
  owns ExternalLinkInternalKind
  responsible_for "主机责任归属实体：责任主体、主机组与成员关系、责任分配（host/host_group 两级）、外部身份映射；有效责任视图与同步游标由 HostResponsibilityService 承载。"
}
