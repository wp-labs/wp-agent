  value
  timestamp
}

// MetricsTargetView 是采集目标视图（读投影），形状由实现层派生，不建模进模型。

struct WarpParseIngestHead {
  api_version
  kind
  encoding
  compression
  record_count
  unique source_id
  agent_id
  instance_id
  collected_at
  sent_at
}

struct WarpParseIngestMessageKind {
  variant
}

struct WarpParseIngestEncoding {
  variant
}

struct WarpParseIngestCompression {
  variant
}

struct LogCheckpointState {
  file_checkpoints
  pending_multiline
}

