command CollectLogs {
  input_id
  path
  since_offset
}

command CollectMetrics {
  target_ref
  collection_kind
  collected_at
}

struct FileInputConfig {
  unique input_id
  path
  startup_position
  multiline_mode
}

struct FileInputProcessor {
  config
  state
}

struct ProcessOutcome {
  kind
  batch
  delivery
}

struct ProcessOutcomeKind {
  variant
}

struct RawFileLine {
  offset
  content
}

struct ReadFromOffset {
  offset
  limit
}

struct StartupPosition {
  variant
}

struct ResumeDecision {
  start_offset
}

struct IfEmptyThen {
  variant
}

struct MultilineMode {
  variant
}

struct FoldedLine {
  lines
  start_offset
  end_offset
}

struct FoldResult {
  folded
  remainder
}

struct RecordSink {
}

struct TelemetryRecordSink {
  kind
}

struct FileRecordSink {
  path
}

struct TcpRecordSink {
  addr
  port
  framing
}

struct TcpFraming {
  variant
}

struct StageResult {
  staged
  overflow
}

struct TelemetryBuffer {
