struct PodInventory {
  meta {
    label zh "Pod 资产目录"
    label en "Pod HostInventory"
    summary zh "稳定 pod 目录对象：pod 身份、命名空间、负载归属与最近已知调度节点。"
    tags "center", "topology", "pod"
  }

  unique pod_id: String
  tenant_id: String
  environment_id: String
  cluster_id: String?
  namespace: String
  workload_id: String?
  pod_uid: String
  pod_name: String
  node_id: String?
  phase: String?
  first_seen_at: DateTime
  last_seen_at: DateTime
}

struct NetworkDomain {
  meta {
    label zh "网络域"
    label en "Network Domain"
    tags "center", "topology", "network"
  }

  unique network_domain_id: String
  tenant_id: String
  environment_id: String
  kind: NetworkDomainKind
  name: String
  external_ref: String?
}

variant NetworkDomainKind {
  meta {
    label zh "网络域类型"
    label en "Network Domain Kind"
  }

  Vpc
  VlanFabric
  K8sClusterNetwork
  CniFabric
}

struct NetworkSegment {
  meta {
    label zh "网络段"
    label en "Network Segment"
    tags "center", "topology", "network"
  }

  unique network_segment_id: String
  network_domain_id: String
  segment_type: NetworkSegmentType
  name: String
  cidr: String?
  gateway_ip: String?
}

variant NetworkSegmentType {
  meta {
    label zh "网络段类型"
    label en "Network Segment Type"
  }

  Subnet
  Overlay
  PodNetwork
  ServiceNetwork
  NamespaceNetwork
}

struct PodPlacement {
  meta {
    label zh "Pod 调度归属"
    label en "Pod Placement"
    tags "center", "topology", "pod"
  }

  unique placement_id: String
  pod_id: String
  host_id: String
  source: String
  valid_from: DateTime
  valid_to: DateTime?
}

struct PodNetworkAttachment {
  meta {
    label zh "Pod 网络附件"
    label en "Pod Network Attachment"
    tags "center", "topology", "network"
  }

  unique attachment_id: String
  pod_id: String
  network_segment_id: String
  interface_name: String?
  ip_addr: String?
  mac_addr: String?
  is_primary: Bool
  source: AttachmentSource
  valid_from: DateTime
  valid_to: DateTime?
}

struct HostNetworkAttachment {
  meta {
    label zh "主机网络附件"
    label en "Host Network Attachment"
    tags "center", "topology", "network"
  }

  unique attachment_id: String
  host_id: String
  network_segment_id: String
  interface_name: String?
  ip_addr: String?
  mac_addr: String?
  is_primary: Bool
  source: AttachmentSource
  valid_from: DateTime
  valid_to: DateTime?
}

variant AttachmentSource {
  meta {
    label zh "附件来源"
    label en "Attachment Source"
  }

  K8sApi
  CniSync
  RuntimeHint
}
