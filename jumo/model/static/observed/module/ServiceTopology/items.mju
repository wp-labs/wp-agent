struct BusinessDomain {
  meta {
    label zh "业务域"
    label en "Business Domain"
    tags "center", "topology", "business"
  }

  unique business_id: String
  tenant_id: String
  name: String
  code: String?
  description: String?
  lifecycle_state: String?
}

struct SystemBoundary {
  meta {
    label zh "系统边界"
    label en "System Boundary"
    tags "center", "topology", "business"
  }

  unique system_id: String
  business_id: String
  tenant_id: String
  name: String
  code: String?
  description: String?
  parent_system_id: String?
}

struct BusinessSubsystem {
  meta {
    label zh "业务子系统"
    label en "Business Subsystem"
    tags "center", "topology", "business"
  }

  unique subsystem_id: String
  system_id: String
  tenant_id: String
  name: String
  code: String?
  description: String?
}

struct ServiceEntity {
  meta {
    label zh "逻辑服务"
    label en "Service Entity"
    tags "center", "topology", "service"
  }

  unique service_id: String
  tenant_id: String
  business_id: String?
  system_id: String?
  subsystem_id: String?
  namespace: String?
  name: String
  service_type: ServiceType
  language: String?
  lifecycle_state: String?
}

variant ServiceType {
  meta {
    label zh "服务类型"
    label en "Service Type"
  }

  Api
  Worker
  Scheduler
  Gateway
  DatabaseAdapter
}

struct ServiceInstance {
  meta {
    label zh "服务实例"
    label en "Service Instance"
    tags "center", "topology", "service"
  }

  unique service_instance_id: String
  service_id: String
  runtime_type: ServiceRuntimeType
  pod_id: String?
  process_id: String?
  host_id: String?
  version: String?
  state: ServiceInstanceLifecycleState?
  started_at: DateTime?
  last_seen_at: DateTime
}

variant ServiceRuntimeType {
  meta {
    label zh "服务运行载体"
    label en "Service Runtime Type"
  }

  Pod
  Container
  Process
  Vm
}

variant ServiceInstanceLifecycleState {
  meta {
    label zh "服务实例生命周期状态"
    label en "Service Instance Lifecycle State"
  }

  Running
  Stopped
  Pending
  Terminating
}

struct ServiceEndpoint {
  meta {
    label zh "服务入口地址"
    label en "Service Endpoint"
    tags "center", "topology", "service"
  }

  unique endpoint_id: String
  service_id: String
  endpoint_type: ServiceEndpointType
  address: String
  port: Int?
  protocol: String
  exposure_scope: ExposureScope
  valid_from: DateTime
  valid_to: DateTime?
}

variant ServiceEndpointType {
  meta {
    label zh "服务入口类型"
    label en "Service Endpoint Type"
  }

  Dns
  Vip
  Ingress
  LoadBalancer
  NodePort
  External
}

variant ExposureScope {
  meta {
    label zh "暴露范围"
    label en "Exposure Scope"
  }

  ClusterInternal
  VpcInternal
  Public
}

struct ServiceInstanceEndpoint {
  meta {
    label zh "服务实例地址"
    label en "Service Instance Endpoint"
    tags "center", "topology", "service"
  }

  unique instance_endpoint_id: String
  service_instance_id: String
  address: String
  port: Int
  protocol: String
  source: String
  valid_from: DateTime
  valid_to: DateTime?
}

struct ServiceDependency {
  meta {
    label zh "服务依赖"
    label en "Service Dependency"
    tags "center", "topology", "service"
  }

  unique dependency_id: String
  upstream_service_id: String
  downstream_service_id: String
  dependency_type: DependencyType
  dependency_scope: DependencyScope
  criticality: Int?
  source: String
  valid_from: DateTime
  valid_to: DateTime?
}

variant DependencyType {
  meta {
    label zh "依赖类型"
    label en "Dependency Type"
  }

  SyncRpc
  AsyncMq
  Database
  Cache
  ExternalApi
}

variant DependencyScope {
  meta {
    label zh "依赖来源"
    label en "Dependency Scope"
  }

  Declared
  Observed
}
