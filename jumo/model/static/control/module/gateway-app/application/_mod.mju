module<service> GatewayApp.Application {
  meta {
    label zh "网关应用编排"
    label en "Gateway Application Orchestration"
    summary zh "负责 WarpGateway 应用层的用例级编排：网关总览、Agent 列表指令下发等命令与流程，组合控制面与网关管理 Domain 模块完成编排。"
    tags "control", "gateway", "application"
  }

  layer Application
  depends Control.Agent.Enrollment, Control.Agent.Registration, Control.Agent.Identity, Control.Agent.Credential
  depends Control.Agent.Status, Control.Agent.Command
  depends Protocol, Control.Agent.Registry
  depends Control.Gateway.Management, Control.Gateway.Management
}
