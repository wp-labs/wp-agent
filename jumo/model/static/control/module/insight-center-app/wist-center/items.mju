// Module: WistCenter — 全局控制中心应用编排
//
// WistCenter 的 Application 层编排：网关列表聚合、全局策略下发等
// 用例级命令与流程，组合各 Domain 模块的事实完成编排。

command ViewGatewayList = OperatorRequest {
  meta {
    label zh "查看网关列表"
    label en "View Gateway List"
    tags "center", "gateway", "list"
  }

}

// 注意：GatewayListView 是查询/聚合视图（message<response>），非领域实体，
// 不由 flow 创建——列表视图由 handler 聚合返回。

flow DispatchGlobalPolicyFlow {
  meta {
    label zh "下发全局策略"
    label en "Dispatch Global Policy Flow"
    tags "center", "policy"
  }

  actor PlatformMaintenanceEngineer
  trigger AdminDispatchGlobalPolicy

  creates GlobalPolicyDispatch

  step<stop> DispatchPolicy {
    create GlobalPolicyDispatch {
      dispatch_id = AdminDispatchGlobalPolicy.requested_by
      policy_version = AdminDispatchGlobalPolicy.policy_version
      target_count = AdminDispatchGlobalPolicy.gateway_ids
      status = "accepted"
      dispatched_at = "now"
    }
  }
}

// ── 全局编排：Gateway 接入 WistCenter（跨 center/gateway 泳道） ──
