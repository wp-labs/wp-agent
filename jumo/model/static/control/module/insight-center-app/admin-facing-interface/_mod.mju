module<interface> InsightCenterApp.AdminFacingInterface {
  meta {
    label zh "全局控制中心管理接口"
    label en "WistCenter Admin Facing Interface"
    summary zh "WistCenter 面向管理员暴露的 HTTP 管理接口，承载网关列表/策略编排与网关实例管理。"
    tags "center", "admin-facing", "management", "backend", "http", "interface"
  }

  layer Application
  provides GatewayProvisioningInterface by protocol<http>
  provides GatewayOpsInterface by protocol<http>
  provides PlatformReleaseInterface by protocol<http>
  depends Control.InsightCenterApp.WistCenter
  depends Control.Gateway.Supervision
  depends Control.InsightCenter.PlatformRelease
  depends Observed.HostInventory, Observed.HostResponsibility
  depends Observed.NetworkTopology, Observed.ServiceTopology
  depends Security.SoftwareVulnerability
}
