// runtime/global：跨子系统全局编排 flow（domain 声明指定归属域）
// GatewayOnboardingFlow 从中心创建、现场安装、init、注册到上报的端到端编排。


// 客户服务工程师（CustomerServiceEngineer）在客户现场下载/安装；WarpGateway 实例的动作由网关侧
// 单入口 flow（GetGatewayInitialConfigFlow / RegisterGatewayFlow / ReportGatewayStatusFlow /
// RenewGatewayCredentialFlow）承载，此处以 WarpGateway 泳道标注时间线。
// 泳道：中心（WistCenter）与网关（WarpGateway）两侧。
// 业务管理员创建实例；客户服务工程师下载安装；中心签发引导、置备派生、签发运行期凭据；
// WarpGateway 实例安装完成后持一次性引导 Token 置备、注册、周期上报。
domain Control
flow GatewayOnboardingFlow {
  meta {
    label zh "Gateway 接入整体流程"
    label en "Gateway Onboarding Flow"
    summary zh "WarpGateway 从中心创建、客户现场下载/安装、init 置备、注册到运行期上报/续期的端到端编排；业务管理员（BusinessAdministrator）中心侧创建、客户服务工程师（CustomerServiceEngineer）现场部署；泳道：中心（WistCenter）/ 网关（WarpGateway）。"
    tags "gateway", "onboarding", "enrollment"
  }

  actor BusinessAdministrator
  actor CustomerServiceEngineer

  lane WistCenter for Control.InsightCenterApp.WistCenter
  lane WarpGateway for Control.GatewayApp.Application

  depends GatewayBootstrapToken, ControlCenterTrustBundle

  creates GatewayEnrollmentToken
  creates GatewayInitialConfig
  creates GatewayStatusAccepted

  // ① 业务管理员经中心管理台创建实例——由 AdminCreateGatewayInstanceFlow.CreateInstance 承载；
  // 本步骤是时间线标记（创建动作不在本 flow 重复），不消费实例。
  step CreateGatewayInstance in WistCenter by AdminCreateGatewayInstance {
    next IssueBootstrapToken
  }

  // ② 中心签发一次性置备引导 Token（BOOTSTRAP_TOKEN，只存 sha256，短 TTL，绑定实例）——由
  // AdminCreateGatewayInstanceFlow.IssueBootstrapToken 承载；本步骤是时间线标记，不消费 token。
  step IssueBootstrapToken in WistCenter {
    next RevealBootstrapToken
  }

  // ③ 中心经 admin 页面一次性展示引导 Token 明文给工程师（只存 sha256；明文仅此一次展示、
  // 不入 create API 响应）。token 已在系统内（② 签发），展示即读取系统内记录，无需外部输入；
  // 工程师线下携带、安装时注入容器。分发通道保密即 B 方案安全基石。
  step RevealBootstrapToken in WistCenter {
    next DownloadGatewayImage
  }

  // ④ 在网关侧拉取镜像（docker pull）；由 GatewayImageDownloadRequested 命令驱动（客户服务工程师
  // 发起下载，区别于 ① 的管理员命令；命令的 gateway_id / instance_id 必须匹配流程实例）。镜像 spec
  // 是部署定义（拉哪个镜像），非外部运行时输入，不加 input；镜像以 digest / signature 绑定并携带
  // 独立信任锚（signer_id / release_manifest_ref），供 ⑤ 安装前校验完整性。
  step DownloadGatewayImage in WarpGateway by GatewayImageDownloadRequested {
    next InstallGatewayContainer
  }

  // ⑤ 在网关侧启动容器（docker run，注入 init_url + setup_token）；由 GatewayContainerInstallRequested
  // 命令驱动（客户服务工程师发起安装，区别于 ① 的管理员命令；命令的 gateway_id / instance_id 必须匹配
  // 流程实例）。安装前校验镜像摘要与签名（GatewayImage.image_digest / image_signature，见 ④）——预期值
  // 取自**中心签发的 release manifest**（GatewayImage.release_manifest_ref），signer_id 用于 pin 发行方
  // 公钥，而非随镜像返回的仓库 manifest，防循环信任（控制仓库者不能同时控制预期值）。bootstrap 与中心
  // 信任包（control-center.pem）随安装注入：走 env / setup_token，不走 URL query，防日志泄露。
  // 信任包须早于 init 到达（供 ⑥ 校验中心证书）。
  step InstallGatewayContainer in WarpGateway by GatewayContainerInstallRequested {
    receive GatewayBootstrapToken from input
    receive ControlCenterTrustBundle from input
    next VerifyCenterTls
  }

  // ⑥ 网关侧校验中心 HTTPS 证书：对照 ⑤ 已注入的 ControlCenterTrustBundle（server_name /
  // expected_san）验证中心身份通过后，才上送 bootstrap，防 MITM 截获引导 Token。信任包已在 ⑤
  // 注入本侧，此处仅使用，不加 input。
  step VerifyCenterTls in WarpGateway {
    next ValidateBootstrapToken
  }

  // ⑦ 中心校验并一次性消费引导 Token（Bearer bootstrap）：比对 token_hash、校验 gateway_id 与
  // instance_id 绑定、未超期（超期 status → Expired）；消费后 status → Consumed、used_count+1，防重放。
  // 仅 lifecycle_state = Provisioned 的实例可 init，校验通过后迁移 → Initializing，防止已初始化实例重复置备。
  step ValidateBootstrapToken in WistCenter {
    next CallInitUrl
  }

  // ⑧ WarpGateway 实例调 init-url（Bearer 一次性 bootstrap）；中心由引导 Token 直接签发
  // REGIST_TOKEN 落 enrollment、出 config.toml。REGIST_TOKEN 绑定签发时的 gateway_id / instance_id，
  // 注册时校验与请求方一致；短 TTL，逾期未注册自动失效。config.toml 内含 REGIST_TOKEN 明文，须经强 TLS
  // 回传（网关已校验中心证书，见 ⑥）；config 携带控制中心端点、TLS 强制开关与信任包（运行期轮换用，
  // init 校验用信任包见 ⑤）；enrollment_token_id 即后续注册时提交的 REGIST_TOKEN 来源，注册流程校验并
  // 一次性消费。
  step CallInitUrl in WistCenter {
    receive GatewayBootstrapToken from input
    create GatewayEnrollmentToken {
      token_id = "enroll-regist-001"
      gateway_id = AdminCreateGatewayInstance.gateway_name
      instance_id = AdminCreateGatewayInstance.instance_id
      token_hash = "sha256:regist-token-hash"
      max_uses = 1
      used_count = 0
      status = "Active"
      issued_at = "now"
      expires_at = "2026-08-16T00:00:00Z"
    }
    create GatewayInitialConfig {
      gateway_id = AdminCreateGatewayInstance.gateway_name
      instance_id = AdminCreateGatewayInstance.instance_id
      control_center_endpoint = "https://center.warpinsight.example"
      trust_bundle = ControlCenterTrustBundle
      server_tls_required = true
      protocol_version = "1.0"
      enrollment_token_id = "enroll-regist-001"
    }
    next ApplyInitialConfig
  }

  // ⑨ WarpGateway 实例应用返回的 config.toml（写盘、以新配置进入初始化态，完成 init）。
  step ApplyInitialConfig in WarpGateway {
    receive GatewayInitialConfig from CallInitUrl
    next SubmitRegistration
  }

  // ⑩ WarpGateway 实例持 REGIST_TOKEN 注册（一次性消费）：提交的 token 即 config.toml
  // [enrollment] 的明文 REGIST_TOKEN（= enrollment_token_id）；RegisterGatewayFlow 校验并消费
  // （used_count+1 → Used）。
  step SubmitRegistration in WarpGateway {
    receive GatewayEnrollmentToken from CallInitUrl
    next ReceiveRuntimeCredential
  }

  // ⑪ 注册成功后中心签发独立运行期凭据（RUNTIME_TOKEN，可轮换）——签发由 RegisterGatewayFlow
  // 承载（注册成功即签发）；本步骤为网关侧接收注册回执中的运行期凭据，不在本 flow 重复签发。
  step ReceiveRuntimeCredential in WarpGateway {
    receive GatewayCredentialBundle from RegisterGatewayFlow
    next ReportGatewayStatus
  }

  // ⑫ WarpGateway 实例周期上报运行状态（绑定具体实例）。
  step<stop> ReportGatewayStatus in WarpGateway {
    create GatewayStatusAccepted {
      gateway_id = AdminCreateGatewayInstance.gateway_name
      instance_id = AdminCreateGatewayInstance.instance_id
      accepted_at = "now"
    }
  }
}
